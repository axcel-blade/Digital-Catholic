---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import { buildSiteNav } from '../lib/siteNav';
import SEOHead from '../components/SEOHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
	formatPageTitle,
	getAbsoluteUrl,
	getBreadcrumbJsonLd,
	getCanonicalUrl,
	getDefaultOgImage,
	SITE,
	type BreadcrumbItem,
} from '../lib/seo';

interface Props {
	title: string;
	description: string;
	currentPath: string;
	/** Article-specific social image (root-relative with base, or absolute) */
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: 'website' | 'article';
	/** Adds BreadcrumbList structured data */
	breadcrumbs?: BreadcrumbItem[];
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	currentPath,
	ogImage,
	ogImageAlt,
	ogType = 'website',
	breadcrumbs,
	jsonLd,
} = Astro.props;

const nav = buildSiteNav(currentPath);
const pageTitle = formatPageTitle(title);
const canonicalURL = getCanonicalUrl(Astro.url);
const socialImage = ogImage ? getAbsoluteUrl(ogImage) : getDefaultOgImage();
const socialImageAlt = ogImage ? (ogImageAlt ?? title) : SITE.ogImageAlt;

const extraJsonLd = [
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
	...(breadcrumbs && breadcrumbs.length > 1 ? [getBreadcrumbJsonLd(breadcrumbs, canonicalURL)] : []),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="theme-color" content={SITE.themeColor} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
		<SEOHead
			title={pageTitle}
			description={description}
			canonicalUrl={canonicalURL}
			ogImage={socialImage}
			ogImageAlt={socialImageAlt}
			ogImageSize={ogImage ? undefined : { width: 1200, height: 630 }}
			ogType={ogType}
			jsonLd={extraJsonLd}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader nav={nav} />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<SiteFooter nav={nav} />
	</body>
</html>
