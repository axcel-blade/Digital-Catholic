---
import '../styles/global.css';
import { withBase, stripBase } from '../lib/paths';
import SEOHead from '../components/SEOHead.astro';
import SiteSearch from '../components/SiteSearch.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteHeaderMenu from '../components/SiteHeaderMenu.astro';
import {
	formatPageTitle,
	getCanonicalUrl,
	getDefaultOgImage,
	getAbsoluteUrl,
	SITE,
} from '../lib/seo';

interface Props {
	title: string;
	description?: string;
	currentPath: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description = SITE.defaultDescription,
	currentPath,
	ogImage,
	ogType = 'website',
	jsonLd,
} = Astro.props;

const routePath = stripBase(currentPath);

function isNavActive(href: string, path: string): boolean {
	const route = stripBase(href);
	if (route === '/') return path === '/';
	return path === route || path.startsWith(`${route}/`);
}

const navItems = [
	{ href: withBase('/'), label: 'Home' },
	{ href: withBase('/about'), label: 'About' },
	{ href: withBase('/saints'), label: 'Saints' },
	{ href: withBase('/sacraments'), label: 'Sacraments' },
	{ href: withBase('/miracles'), label: 'Miracles' },
	{ href: withBase('/eucharistic-miracles'), label: 'Eucharistic' },
	{ href: withBase('/parables'), label: 'Parables' },
	{ href: withBase('/commandments'), label: 'Commandments' },
	{ href: withBase('/rosary'), label: 'Rosary' },
].map((item) => ({
	...item,
	isActive: isNavActive(item.href, routePath),
}));

const pageTitle = formatPageTitle(title);
const canonicalURL = getCanonicalUrl(Astro.url);
const socialImage = ogImage ? getAbsoluteUrl(ogImage) : getDefaultOgImage();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				var key = 'digital-catholic-theme';
				var stored = localStorage.getItem(key);
				var theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<meta name="theme-color" content={SITE.themeColor} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<SEOHead
			title={pageTitle}
			description={description}
			canonicalUrl={canonicalURL}
			ogImage={socialImage}
			ogType={ogType}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-logo" href={withBase('/')}>Digital Catholic</a>
				<div class="site-header__actions">
					<SiteSearch />
					<ThemeToggle />
				</div>
				<SiteHeaderMenu items={navItems} />
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<p>Digital Catholic — faith, formation, and knowledge for all.</p>
		</footer>
	</body>
</html>
