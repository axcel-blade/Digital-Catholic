---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareLink from '../components/ShareLink.astro';
import StatusBadge from '../components/StatusBadge.astro';
import TrustPanel from '../components/TrustPanel.astro';
import { getAbsoluteUrl, getCanonicalUrl, SITE, type BreadcrumbItem } from '../lib/seo';
import { getSection } from '../lib/sections';
import { withBase } from '../lib/paths';
import type { PublicImage } from '../lib/images';
import type { TrustInfo } from '../data/lib/trust';
import {
	buildToc,
	TOC_MIN_SECTIONS,
	type ArticleLink,
	type ArticleSection,
} from '../lib/article';

export interface ArticleMeta {
	term: string;
	value: string;
}

interface Props {
	title: string;
	description: string;
	currentPath: string;
	/** Key from src/lib/sections.ts — drives breadcrumbs and the return link */
	sectionKey: string;
	/** Category label shown above the title */
	label: string;
	lead?: string;
	meta?: ArticleMeta[];
	image?: PublicImage | null;
	imageCaption?: string;
	/** Sections rendered in the body; used for the "On this page" list */
	sections?: ArticleSection[];
	prev?: ArticleLink;
	next?: ArticleLink;
	related?: ArticleLink[];
	trust?: TrustInfo;
	/** Extra crumbs between the section and the article */
	extraCrumbs?: BreadcrumbItem[];
}

const {
	title,
	description,
	currentPath,
	sectionKey,
	label,
	lead,
	meta = [],
	image,
	imageCaption,
	sections = [],
	prev,
	next,
	related = [],
	trust,
	extraCrumbs = [],
} = Astro.props;

const section = getSection(sectionKey);
const sectionHref = withBase(section.href);
const breadcrumbs: BreadcrumbItem[] = [
	{ label: 'Home', href: withBase('/') },
	{ label: section.title, href: sectionHref },
	...extraCrumbs,
	{ label: title },
];

const toc = sections.length >= TOC_MIN_SECTIONS ? buildToc(sections) : [];
const hasAside = Boolean(image) || toc.length > 0;
const canonicalUrl = getCanonicalUrl(Astro.url);

const articleJsonLd = {
	'@type': 'Article',
	headline: title,
	description,
	articleSection: section.title,
	inLanguage: 'en',
	...(image && { image: getAbsoluteUrl(image.src) }),
	author: { '@type': 'Organization', name: SITE.name },
	publisher: { '@id': `${getAbsoluteUrl(import.meta.env.BASE_URL)}#organization` },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
	...(trust?.lastReviewed && { dateModified: trust.lastReviewed }),
};
---

<BaseLayout
	title={title}
	description={description}
	currentPath={currentPath}
	ogImage={image?.src}
	ogImageAlt={image?.alt}
	ogType="article"
	breadcrumbs={breadcrumbs}
	jsonLd={articleJsonLd}
>
	<div class="container article-page">
		<Breadcrumbs items={breadcrumbs} />

		<article class:list={['article', { 'article--with-aside': hasAside }]}>
			<header class="article-header">
				<p class="eyebrow">{label}</p>
				<h1 class="article-header__title">{title}</h1>
				{lead && <p class="article-header__lead">{lead}</p>}
				{(meta.length > 0 || trust?.churchStatus) && (
					<dl class="article-meta">
						{meta.map((item) => (
							<div class="article-meta__item">
								<dt>{item.term}</dt>
								<dd>{item.value}</dd>
							</div>
						))}
						{trust?.churchStatus && (
							<div class="article-meta__item">
								<dt>Church status</dt>
								<dd><StatusBadge status={trust.churchStatus} /></dd>
							</div>
						)}
					</dl>
				)}
				<ShareLink url={canonicalUrl} title={title} />
			</header>

			{hasAside && (
				<aside class="article-aside" aria-label="Article illustration and contents">
					{image && (
						<figure class="article-figure">
							<img
								src={image.src}
								alt={image.alt}
								width={image.width}
								height={image.height}
								loading="eager"
								fetchpriority="high"
								decoding="async"
							/>
							{imageCaption && <figcaption>{imageCaption}</figcaption>}
						</figure>
					)}
					{toc.length > 0 && (
						<>
							<details class="toc toc--compact">
								<summary class="toc__summary">On this page</summary>
								<ol class="toc__list">
									{toc.map((entry) => (
										<li><a href={`#${entry.id}`}>{entry.heading}</a></li>
									))}
								</ol>
							</details>
							<nav class="toc toc--sticky" aria-label="On this page">
								<p class="toc__title">On this page</p>
								<ol class="toc__list">
									{toc.map((entry) => (
										<li><a href={`#${entry.id}`}>{entry.heading}</a></li>
									))}
								</ol>
							</nav>
						</>
					)}
				</aside>
			)}

			<div class="article-main">
				<div class="prose article-body">
					<slot />
				</div>

				<TrustPanel trust={trust} />

				{(prev || next) && (
					<nav class="article-pager" aria-label={`More in ${section.title}`}>
						{prev ? (
							<a class="article-pager__link article-pager__link--prev" href={prev.href} rel="prev">
								<span class="article-pager__dir">Previous</span>
								<span class="article-pager__title">{prev.title}</span>
							</a>
						) : <span />}
						{next && (
							<a class="article-pager__link article-pager__link--next" href={next.href} rel="next">
								<span class="article-pager__dir">Next</span>
								<span class="article-pager__title">{next.title}</span>
							</a>
						)}
					</nav>
				)}
			</div>
		</article>

		{related.length > 0 && (
			<section class="related" aria-labelledby="related-title">
				<h2 class="related__title" id="related-title">Related reading</h2>
				<ul class="card-grid card-grid--compact">
					{related.map((item) => (
						<li class="card">
							<div class="card__body">
								{item.label && <p class="card__label">{item.label}</p>}
								<h3 class="card__title"><a class="card__link" href={item.href}>{item.title}</a></h3>
								{item.excerpt && <p class="card__excerpt">{item.excerpt}</p>}
								<span class="card__action" aria-hidden="true">Read <span class="card__arrow">→</span></span>
							</div>
						</li>
					))}
				</ul>
			</section>
		)}

		<p class="back-link">
			<a href={sectionHref}><span aria-hidden="true">←</span> Back to {section.title}</a>
		</p>
	</div>
</BaseLayout>
