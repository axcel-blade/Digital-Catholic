---
import { withBase } from '../lib/paths';

const indexUrl = withBase('/search-index.json');
---

<div class="search-panel" id="site-search-panel" hidden data-search-panel data-index-url={indexUrl}>
	<div class="search-panel__inner">
		<form class="search-panel__form" role="search" action="#" data-search-form>
			<label class="search-panel__label" for="site-search-input">Search Digital Catholic</label>
			<div class="search-panel__field">
				<svg class="search-panel__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
				<input
					class="search-panel__input"
					id="site-search-input"
					type="search"
					name="q"
					placeholder="Saints, sacraments, prayers, Scripture…"
					autocomplete="off"
					spellcheck="false"
					role="combobox"
					aria-autocomplete="list"
					aria-expanded="false"
					aria-controls="site-search-results"
					aria-describedby="site-search-hint"
				/>
				<button type="button" class="search-panel__close" data-search-close>
					<span class="visually-hidden">Close search</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
				</button>
			</div>
			<p class="search-panel__hint" id="site-search-hint">
				Type at least two letters. Use the up and down arrow keys to move through results and Enter to open one. Press Escape to close.
			</p>
		</form>
		<ul class="search-results" id="site-search-results" role="listbox" aria-label="Search results" hidden></ul>
		<p class="search-panel__status" role="status" aria-live="polite" data-search-status></p>
	</div>
</div>

<script>
	interface SearchEntry {
		title: string;
		url: string;
		category: string;
		excerpt: string;
		body: string;
	}

	const panel = document.querySelector<HTMLElement>('[data-search-panel]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');

	if (panel && toggle) {
		const input = panel.querySelector<HTMLInputElement>('#site-search-input')!;
		const list = panel.querySelector<HTMLUListElement>('#site-search-results')!;
		const status = panel.querySelector<HTMLElement>('[data-search-status]')!;
		const form = panel.querySelector<HTMLFormElement>('[data-search-form]')!;
		const closeButton = panel.querySelector<HTMLButtonElement>('[data-search-close]')!;
		const indexUrl = panel.dataset.indexUrl ?? '';

		const MIN_QUERY = 2;
		const MAX_RESULTS = 12;
		let index: SearchEntry[] | null = null;
		let loading: Promise<SearchEntry[]> | null = null;
		let activeIndex = -1;
		let debounceId = 0;

		function normalize(text: string) {
			return text.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
		}

		function loadIndex(): Promise<SearchEntry[]> {
			if (index) return Promise.resolve(index);
			if (!loading) {
				loading = fetch(indexUrl)
					.then((response) => {
						if (!response.ok) throw new Error(`Search index returned ${response.status}`);
						return response.json() as Promise<SearchEntry[]>;
					})
					.then((entries) => {
						index = entries.map((entry) => ({ ...entry, body: normalize(entry.body) }));
						return index;
					})
					.catch((error) => {
						loading = null;
						throw error;
					});
			}
			return loading;
		}

		function score(entry: SearchEntry, terms: string[]) {
			const title = normalize(entry.title);
			const excerpt = normalize(entry.excerpt);
			const category = normalize(entry.category);
			let total = 0;
			for (const term of terms) {
				const inTitle = title.includes(term);
				const inExcerpt = excerpt.includes(term);
				const inBody = entry.body.includes(term);
				const inCategory = category.includes(term);
				if (!inTitle && !inExcerpt && !inBody && !inCategory) return 0;
				if (title.startsWith(term)) total += 6;
				if (inTitle) total += 12;
				if (inCategory) total += 4;
				if (inExcerpt) total += 5;
				if (inBody) total += 2;
			}
			return total;
		}

		function highlight(text: string, terms: string[]) {
			const fragment = document.createDocumentFragment();
			const normalized = normalize(text);
			const ranges: [number, number][] = [];
			for (const term of terms) {
				let from = 0;
				let at = normalized.indexOf(term, from);
				while (at !== -1 && term.length > 0) {
					ranges.push([at, at + term.length]);
					from = at + term.length;
					at = normalized.indexOf(term, from);
				}
			}
			ranges.sort((a, b) => a[0] - b[0]);
			let cursor = 0;
			for (const [start, end] of ranges) {
				if (start < cursor) continue;
				fragment.append(text.slice(cursor, start));
				const mark = document.createElement('mark');
				mark.textContent = text.slice(start, end);
				fragment.append(mark);
				cursor = end;
			}
			fragment.append(text.slice(cursor));
			return fragment;
		}

		function truncate(text: string, max = 150) {
			if (text.length <= max) return text;
			return `${text.slice(0, text.lastIndexOf(' ', max)).trimEnd()}…`;
		}

		function setActive(next: number) {
			const options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));
			activeIndex = next;
			options.forEach((option, i) => {
				const active = i === activeIndex;
				option.classList.toggle('is-active', active);
				option.setAttribute('aria-selected', String(active));
			});
			const current = options[activeIndex];
			if (current) {
				input.setAttribute('aria-activedescendant', current.id);
				current.scrollIntoView({ block: 'nearest' });
			} else {
				input.removeAttribute('aria-activedescendant');
			}
		}

		function clearResults() {
			list.replaceChildren();
			list.hidden = true;
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
			activeIndex = -1;
		}

		function render(matches: SearchEntry[], terms: string[], query: string) {
			list.replaceChildren();
			activeIndex = -1;
			input.removeAttribute('aria-activedescendant');

			if (matches.length === 0) {
				list.hidden = true;
				input.setAttribute('aria-expanded', 'false');
				status.replaceChildren();
				const strong = document.createElement('strong');
				strong.textContent = `No results for “${query}”.`;
				status.append(strong, ' Try a shorter word, a saint’s name, or a topic such as “Rosary” or “Baptism”.');
				status.classList.add('is-empty');
				return;
			}

			status.classList.remove('is-empty');
			status.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} found.`;

			matches.forEach((match, i) => {
				const option = document.createElement('li');
				option.id = `site-search-option-${i}`;
				option.setAttribute('role', 'option');
				option.setAttribute('aria-selected', 'false');
				option.className = 'search-results__item';

				const link = document.createElement('a');
				link.className = 'search-results__link';
				link.href = match.url;
				link.tabIndex = -1;

				const category = document.createElement('span');
				category.className = 'search-results__category';
				category.textContent = match.category;

				const title = document.createElement('span');
				title.className = 'search-results__title';
				title.append(highlight(match.title, terms));

				const excerpt = document.createElement('span');
				excerpt.className = 'search-results__excerpt';
				excerpt.append(highlight(truncate(match.excerpt), terms));

				link.append(category, title, excerpt);
				option.append(link);
				option.addEventListener('mousemove', () => {
					if (activeIndex !== i) setActive(i);
				});
				list.append(option);
			});

			list.hidden = false;
			input.setAttribute('aria-expanded', 'true');
		}

		async function update() {
			const query = input.value.trim();
			if (query.length < MIN_QUERY) {
				clearResults();
				status.textContent = '';
				status.classList.remove('is-empty');
				return;
			}
			let entries: SearchEntry[];
			try {
				entries = await loadIndex();
			} catch {
				clearResults();
				status.textContent = 'Search is unavailable right now. Please try again later.';
				return;
			}
			if (input.value.trim() !== query) return;
			const terms = normalize(query).split(/\s+/).filter(Boolean);
			const matches = entries
				.map((entry) => ({ entry, score: score(entry, terms) }))
				.filter((row) => row.score > 0)
				.sort((a, b) => b.score - a.score)
				.slice(0, MAX_RESULTS)
				.map((row) => row.entry);
			render(matches, terms, query);
		}

		function openPanel() {
			document.dispatchEvent(new CustomEvent('site:overlay-open', { detail: 'search' }));
			panel!.hidden = false;
			toggle!.setAttribute('aria-expanded', 'true');
			input.focus();
			input.select();
			loadIndex().catch(() => undefined);
		}

		function closePanel(returnFocus = true) {
			panel!.hidden = true;
			toggle!.setAttribute('aria-expanded', 'false');
			if (returnFocus) toggle!.focus();
		}

		toggle.addEventListener('click', () => {
			if (panel.hidden) openPanel();
			else closePanel();
		});

		closeButton.addEventListener('click', () => closePanel());

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const options = list.querySelectorAll<HTMLAnchorElement>('[role="option"] a');
			const target = options[activeIndex >= 0 ? activeIndex : 0];
			if (target) window.location.href = target.href;
		});

		input.addEventListener('input', () => {
			window.clearTimeout(debounceId);
			debounceId = window.setTimeout(update, 120);
		});

		input.addEventListener('keydown', (event) => {
			const count = list.querySelectorAll('[role="option"]').length;
			if (event.key === 'ArrowDown' && count > 0) {
				event.preventDefault();
				setActive(activeIndex < count - 1 ? activeIndex + 1 : 0);
			} else if (event.key === 'ArrowUp' && count > 0) {
				event.preventDefault();
				setActive(activeIndex > 0 ? activeIndex - 1 : count - 1);
			} else if (event.key === 'Home' && count > 0 && activeIndex >= 0) {
				event.preventDefault();
				setActive(0);
			} else if (event.key === 'End' && count > 0 && activeIndex >= 0) {
				event.preventDefault();
				setActive(count - 1);
			}
		});

		panel.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			event.preventDefault();
			event.stopPropagation();
			closePanel();
		});

		document.addEventListener('keydown', (event) => {
			const target = event.target as HTMLElement | null;
			const typing =
				target &&
				(target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
			if (event.key === '/' && !typing && panel.hidden) {
				event.preventDefault();
				openPanel();
			}
		});

		document.addEventListener('site:overlay-open', (event) => {
			if ((event as CustomEvent).detail !== 'search' && !panel.hidden) closePanel(false);
		});

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (panel.hidden || !(target instanceof Node)) return;
			if (!panel.contains(target) && !toggle.contains(target)) closePanel(false);
		});
	}
</script>
