---
import type { ResolvedNavGroup } from '../lib/siteNav';

interface Props {
	exploreGroup: ResolvedNavGroup;
}

const { exploreGroup } = Astro.props;
---

<div
	class:list={['site-header__explore', exploreGroup.isActive && 'is-active']}
	id="site-nav-explore-group"
>
	<button
		type="button"
		class="site-nav__group-toggle"
		id="site-nav-explore-toggle"
		aria-expanded="false"
		aria-controls="site-nav-explore-dropdown"
		aria-haspopup="true"
	>
		{exploreGroup.label}
		<svg
			class="site-nav__group-chevron"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M6 9l6 6 6-6"></path>
		</svg>
	</button>
	<ul class="site-nav__dropdown" id="site-nav-explore-dropdown" role="list">
		{exploreGroup.items.map((item) => (
			<li>
				<a href={item.href} aria-current={item.isActive ? 'page' : undefined}>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</div>
