---
import type { LiturgicalYear } from '../data/liturgical-calendar/types';
import { formatCalendarDate } from '../data/liturgical-calendar';
import { withBase } from '../lib/paths';

interface Props {
	yearData: LiturgicalYear;
	yearOptions: number[];
	/** Civil year used for the main `/liturgical-calendar` route (the build year). */
	defaultYear: number;
}

const { yearData, yearOptions, defaultYear } = Astro.props;
const rankLabels: Record<string, string> = {
	solemnity: 'Solemnity',
	feast: 'Feast',
	memorial: 'Memorial',
	'optional-memorial': 'Optional memorial',
	season: 'Season',
};
const colorLabels: Record<string, string> = {
	white: 'White',
	red: 'Red',
	green: 'Green',
	purple: 'Purple',
	rose: 'Rose',
};
const months = yearData.months.filter((m) => m.days.length > 0);
const celebrations = yearData.months.flatMap((m) =>
	m.days.map((d) => ({ date: d.date, title: d.title }))
);
---

<div class="liturgical-calendar" data-liturgical-calendar>
	<nav class="year-nav" aria-label="Calendar year">
		<span class="year-nav__label">Year</span>
		<ul class="year-nav__list">
			{yearOptions.map((y) => (
				<li>
					<a
						class="year-nav__link"
						href={withBase(y === defaultYear ? '/liturgical-calendar' : `/liturgical-calendar/${y}`)}
						aria-current={y === yearData.year ? 'page' : undefined}
					>
						{y}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<div class="calendar-summary">
		<section class="calendar-summary__card calendar-summary__card--today" id="liturgical-today" aria-labelledby="liturgical-today-title" hidden>
			<h2 class="calendar-summary__title" id="liturgical-today-title">Today</h2>
			<p class="calendar-summary__date" id="liturgical-today-date"></p>
			<p class="calendar-summary__season" id="liturgical-today-season"></p>
			<ul class="calendar-summary__list" id="liturgical-today-list"></ul>
			<p class="calendar-summary__fine">Based on your device’s date and the universal calendar.</p>
		</section>
		<section class="calendar-summary__card" aria-labelledby="year-glance-title">
			<h2 class="calendar-summary__title" id="year-glance-title">{yearData.year} at a glance</h2>
			<p class="calendar-summary__easter">
				<strong>Easter Sunday:</strong> {formatCalendarDate(yearData.easter)}
			</p>
			<ul class="season-list">
				{yearData.seasons.map((season) => (
					<li class="season-list__item">
						<span class="season-list__name">{season.name}</span>
						<span class="season-list__dates">
							{formatCalendarDate(season.start)} – {formatCalendarDate(season.end)}
						</span>
					</li>
				))}
			</ul>
		</section>
	</div>

	<div class="calendar-legend">
		<p class="calendar-legend__label" id="calendar-legend-label">Liturgical colors</p>
		<ul class="calendar-legend__colors" aria-labelledby="calendar-legend-label">
			{Object.entries(colorLabels).map(([key, label]) => (
				<li><span class={`color-dot color-dot--${key}`} aria-hidden="true"></span>{label}</li>
			))}
		</ul>
	</div>

	<nav class="jump-links jump-links--months" aria-label="Jump to month">
		{months.map((month) => (
			<a class="jump-links__link" href={`#month-${month.month}`}>{month.label.slice(0, 3)}<span class="visually-hidden">{month.label.slice(3)}</span></a>
		))}
	</nav>

	{months.map((month) => (
		<section class="calendar-month" id={`month-${month.month}`} aria-labelledby={`month-${month.month}-title`}>
			<h2 class="calendar-month__title" id={`month-${month.month}-title`}>{month.label} {yearData.year}</h2>
			<ul class="calendar-days">
				{month.days.map((day) => (
					<li class={`calendar-day calendar-day--${day.rank}`} data-date={day.date}>
						<time class="calendar-day__date" datetime={day.date}>{formatCalendarDate(day.date)}</time>
						<div class="calendar-day__body">
							<h3 class="calendar-day__title">
								{day.saintSlug ? (
									<a href={withBase(`/saints/${day.saintSlug}`)}>{day.title}</a>
								) : (
									day.title
								)}
							</h3>
							<p class="calendar-day__meta">
								<span class="calendar-day__rank">{rankLabels[day.rank]}</span>
								<span class="calendar-day__color">
									<span class={`color-dot color-dot--${day.color}`} aria-hidden="true"></span>
									<span class="visually-hidden">Liturgical color: </span>{colorLabels[day.color]}
								</span>
								<span class="calendar-day__today-label">Today</span>
							</p>
							{day.note && <p class="calendar-day__note">{day.note}</p>}
						</div>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<script define:vars={{ year: yearData.year, seasons: yearData.seasons, celebrations }}>
	const today = new Date();
	const pad = (n) => String(n).padStart(2, '0');
	const todayIso = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

	if (today.getFullYear() === year) {
		document.querySelectorAll(`[data-date="${todayIso}"]`).forEach((el) => {
			el.classList.add('is-today');
			el.setAttribute('aria-current', 'date');
		});

		const block = document.getElementById('liturgical-today');
		const dateEl = document.getElementById('liturgical-today-date');
		const seasonEl = document.getElementById('liturgical-today-season');
		const listEl = document.getElementById('liturgical-today-list');

		if (block && dateEl && seasonEl && listEl) {
			dateEl.textContent = today.toLocaleDateString('en-US', {
				weekday: 'long',
				month: 'long',
				day: 'numeric',
				year: 'numeric',
			});
			const season = seasons.find((s) => todayIso >= s.start && todayIso <= s.end);
			seasonEl.textContent = season ? `Season: ${season.name}` : '';

			const todays = celebrations.filter((c) => c.date === todayIso);
			const items = todays.length > 0
				? todays.map((c) => c.title)
				: ['No solemnity, feast, or memorial on the universal calendar today.'];
			for (const text of items) {
				const li = document.createElement('li');
				li.textContent = text;
				listEl.appendChild(li);
			}
			block.hidden = false;
		}
	}
</script>
