---
import SectionLayout from '../layouts/SectionLayout.astro';
import ReferenceLine from './ReferenceLine.astro';
import RelatedTopics from './RelatedTopics.astro';
import { getGuide } from '../data/guides';
import { guideImages } from '../data/guides/images';
import { getSection } from '../lib/sections';
import { getCollectionImage } from '../lib/images';
import { withBase } from '../lib/paths';
import { slugify } from '../lib/article';
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
	/** Key from src/lib/sections.ts and folder name in src/data/guides */
	guideKey: string;
	description: string;
	/** Overrides the guide intro, for pages that combine a guide with other content */
	intro?: string;
	/** Overrides the default “N topics” count */
	count?: string;
	/** Section the page belongs to, when the guide is a sub-page of another section */
	sectionKey?: string;
	/** Visible h1 and breadcrumb label for a sub-page */
	heading?: string;
	/** Crumbs between the section and a sub-page */
	extraCrumbs?: BreadcrumbItem[];
}

const { guideKey, description, intro, count, sectionKey = guideKey, heading, extraCrumbs } = Astro.props;
const guide = getGuide(guideKey);
const section = getSection(sectionKey);
const art = guideImages[guideKey];
const topicText = [guide.intro, ...guide.topics.flatMap((t) => [t.title, t.summary, ...t.meaning, ...(t.points?.items ?? [])])].join(' ');
const ownLinks = guide.topics.flatMap((t) => t.links?.map((l) => l.href) ?? []);
const image = art ? getCollectionImage('guides', guideKey, art.alt) : null;
---

<SectionLayout
	sectionKey={sectionKey}
	heading={heading}
	pageCrumb={heading}
	extraCrumbs={extraCrumbs}
	description={description}
	currentPath={Astro.url.pathname}
	intro={intro ?? guide.intro}
	count={count ?? `${guide.topics.length} topics`}
>
	<nav class="jump-links" aria-label={`Jump to a topic in ${heading ?? section.title}`} slot="header">
		{guide.topics.map((t) => (
			<a class="jump-links__link" href={`#${slugify(t.title)}`}>{t.title}</a>
		))}
	</nav>

	<slot name="lead" />

	{image && (
		<figure class="framed-figure guide-figure">
			<img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" />
			<figcaption>{art.caption}</figcaption>
		</figure>
	)}

	<ol class="numbered-list">
		{guide.topics.map((topic) => (
			<li class="numbered-item" id={slugify(topic.title)}>
				{/* Keeps older #topic-N links working */}
				<span class="numbered-item__legacy-anchor" id={`topic-${topic.number}`} aria-hidden="true"></span>
				<span class="numbered-item__number" aria-hidden="true">{topic.number}</span>
				<div class="numbered-item__body">
					<h2 class="numbered-item__title">{topic.title}</h2>
					<blockquote class="numbered-item__quote">{topic.summary}</blockquote>
					<ReferenceLine scripture={topic.scripture} catechism={topic.catechism} />
					{topic.meaning.map((paragraph) => (
						<p class="numbered-item__text">{paragraph}</p>
					))}
					{topic.points && (
						<div class="numbered-item__points">
							<p class="numbered-item__points-title">{topic.points.title}</p>
							<ul>
								{topic.points.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					)}
					{topic.text && (
						<figure class="numbered-item__prayer">
							<figcaption class="numbered-item__prayer-title">{topic.text.title}</figcaption>
							{topic.text.lines.map((line) => (
								<p>{line}</p>
							))}
						</figure>
					)}
					{topic.links?.map((link) => (
						<p class="numbered-item__link">
							<a href={withBase(link.href)}>{link.label} →</a>
						</p>
					))}
				</div>
			</li>
		))}
	</ol>

	<slot name="after" />

	<RelatedTopics currentPath={Astro.url.pathname} text={topicText} exclude={ownLinks} />

	<slot />
</SectionLayout>
