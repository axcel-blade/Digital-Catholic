---
import type { ResolvedNavGroup, ResolvedNavItem } from '../lib/siteNav';

interface Props {
	primary: ResolvedNavItem[];
	exploreGroup: ResolvedNavGroup;
}

const { primary, exploreGroup } = Astro.props;
---

<button
	type="button"
	class="site-header__menu-toggle"
	id="site-header-menu-toggle"
	aria-controls="site-header-menu"
	aria-expanded="false"
	aria-label="Open menu"
>
	<svg
		class="site-header__menu-icon site-header__menu-icon--open"
		width="22"
		height="22"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<path d="M4 7h16M4 12h16M4 17h16"></path>
	</svg>
	<svg
		class="site-header__menu-icon site-header__menu-icon--close"
		width="22"
		height="22"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<path d="M6 6l12 12M18 6 6 18"></path>
	</svg>
</button>

<div class="site-header__menu" id="site-header-menu">
	<nav class="site-header__nav" aria-label="Main">
		<ul class="site-nav">
			{primary.map((item) => (
				<li>
					<a href={item.href} aria-current={item.isActive ? 'page' : undefined}>
						{item.label}
					</a>
				</li>
			))}
			<li class="site-nav__explore-heading">
				<span>{exploreGroup.label}</span>
			</li>
			{exploreGroup.items.map((item) => (
				<li class="site-nav__explore-item">
					<a href={item.href} aria-current={item.isActive ? 'page' : undefined}>
						{item.label}
					</a>
				</li>
			))}
			<li
				class:list={['site-nav__group', exploreGroup.isActive && 'is-active']}
				id="site-nav-explore-group"
			>
				<button
					type="button"
					class="site-nav__group-toggle"
					id="site-nav-explore-toggle"
					aria-expanded="false"
					aria-controls="site-nav-explore-dropdown"
					aria-haspopup="true"
				>
					{exploreGroup.label}
					<svg
						class="site-nav__group-chevron"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6"></path>
					</svg>
				</button>
				<ul class="site-nav__dropdown" id="site-nav-explore-dropdown" role="list">
					{exploreGroup.items.map((item) => (
						<li>
							<a href={item.href} aria-current={item.isActive ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</li>
		</ul>
	</nav>
</div>

<script>
	const toggle = document.getElementById('site-header-menu-toggle');
	const menu = document.getElementById('site-header-menu');
	const exploreToggle = document.getElementById('site-nav-explore-toggle');
	const exploreGroup = document.getElementById('site-nav-explore-group');

	if (!toggle || !menu) throw new Error('Site header menu elements not found');

	const desktopQuery = window.matchMedia('(min-width: 52rem)');

	function setMenuOpen(open) {
		const isOpen = open && !desktopQuery.matches;
		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
		if (isOpen) {
			menu.classList.add('is-open');
		} else {
			menu.classList.remove('is-open');
		}
	}

	function closeMenu() {
		setMenuOpen(false);
	}

	function setExploreOpen(open) {
		if (!exploreToggle || !exploreGroup) return;
		const isOpen = open && desktopQuery.matches;
		exploreToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		exploreGroup.classList.toggle('is-open', isOpen);
	}

	function closeExplore() {
		setExploreOpen(false);
	}

	toggle.addEventListener('click', () => {
		setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	if (exploreToggle && exploreGroup) {
		exploreToggle.addEventListener('click', (event) => {
			event.stopPropagation();
			setExploreOpen(exploreToggle.getAttribute('aria-expanded') !== 'true');
		});
	}

	menu.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			closeMenu();
			closeExplore();
		});
	});

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Node)) return;

		if (!desktopQuery.matches) {
			if (toggle.contains(target) || menu.contains(target)) return;
			closeMenu();
			return;
		}

		if (exploreGroup && !exploreGroup.contains(target)) {
			closeExplore();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeMenu();
			closeExplore();
		}
	});

	desktopQuery.addEventListener('change', () => {
		closeExplore();
		if (desktopQuery.matches) {
			menu.classList.add('is-open');
			toggle.setAttribute('aria-expanded', 'false');
		} else {
			closeMenu();
		}
	});

	if (desktopQuery.matches) {
		menu.classList.add('is-open');
	}
</script>
