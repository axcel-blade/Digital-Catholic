---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBack from '../components/PageBack.astro';
import { PAGE_DESCRIPTIONS } from '../lib/seo';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;

const sections = [
	{
		href: '/saints',
		title: 'Saints',
		description:
			'Biographies of holy men and women—including the Blessed Virgin Mary, St. Joseph, and St. Anthony of Padua—with feast days and lessons for daily life.',
	},
	{
		href: '/sacraments',
		title: 'Sacraments',
		description:
			'Teaching on all seven sacraments: what the Church believes, how they are celebrated, and why they are essential for life in Christ.',
	},
	{
		href: '/miracles',
		title: 'Miracles of Jesus',
		description:
			'Gospel accounts of Christ’s miracles in Matthew, Mark, Luke, and John—what each sign reveals and how it calls us to faith.',
	},
	{
		href: '/eucharistic-miracles',
		title: 'Eucharistic Miracles',
		description:
			'Events in which the consecrated Host bears visible signs of Christ’s Body and Blood—Lanciano, Corpus Christi, and modern shrines of adoration.',
	},
	{
		href: '/parables',
		title: 'Parables of Jesus',
		description:
			'Stories from the Gospels that unfold the Kingdom of God—mercy, prayer, discipleship, and conversion.',
	},
	{
		href: '/commandments',
		title: 'Ten Commandments',
		description:
			'The moral law given to Moses: each commandment’s text and a brief explanation for love of God and neighbor.',
	},
	{
		href: '/rosary',
		title: 'Mysteries of the Rosary',
		description:
			'How to pray the Rosary, the traditional prayers, and meditations on all twenty mysteries.',
	},
];
---

<BaseLayout
	title="About"
	description={PAGE_DESCRIPTIONS.about}
	currentPath={currentPath}
>
	<div class="page-content page-content--catalog">
		<PageBack href={withBase('/')} />
		<div class="catalog-prose">
			<h1>About Digital Catholic</h1>
			<p class="lead">
				Digital Catholic is a free learning site that shares the Catholic faith in clear,
				accessible language—for prayer, formation, catechesis, and everyday reading.
			</p>

			<h2>What you will find here</h2>
			<p>
				We publish short articles drawn from Scripture and the teaching of the Church. Each
				section is written to be read on its own or shared with family, students, and anyone
				seeking to grow in knowledge of Christ.
			</p>
			<ul class="about-section-list">
				{sections.map((section) => (
					<li>
						<a href={withBase(section.href)}>
							<strong>{section.title}</strong>
							<span>{section.description}</span>
						</a>
					</li>
				))}
			</ul>

			<h2>Features</h2>
			<ul>
				<li>
					<strong>Site search</strong> — find saints, sacraments, Gospel articles, commandments,
					and Rosary content from the header on any page.
				</li>
				<li>
					<strong>Dark mode</strong> — switch between light and dark themes; your preference is
					saved in your browser.
				</li>
				<li>
					<strong>Responsive layout</strong> — readable on phones, tablets, and desktop.
				</li>
			</ul>

			<h2>Our approach</h2>
			<p>
				Content is offered for knowledge and devotion, not as a substitute for the Magisterium,
				your parish, or spiritual direction. We aim for accuracy and reverence in presenting
				what Catholics believe and how the saints and sacraments help us live the Gospel.
			</p>

			<h2>Knowledge for sharing</h2>
			<p>
				Everything on this site is meant to be read, learned, and shared. Whether you are new
				to the faith, preparing for a sacrament, studying the Gospels, or deepening your
				prayer life, Digital Catholic exists to make sound Catholic teaching available to all
				who wish to grow in understanding and love of Christ and His Church.
			</p>
		</div>
	</div>
</BaseLayout>
