---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { PAGE_DESCRIPTIONS, type BreadcrumbItem } from '../lib/seo';
import { withBase } from '../lib/paths';
import { getPublicImage } from '../lib/images';
import { sectionGroups, getSectionsInGroup, siteSections } from '../lib/sections';

const breadcrumbs: BreadcrumbItem[] = [{ label: 'Home', href: withBase('/') }, { label: 'About' }];
const image = getPublicImage(
	'/about/jesus-teaching.jpg',
	'Christ teaching the people—the Sermon on the Mount, painting by Carl Heinrich Bloch (public domain)'
);
const groups = sectionGroups.map((group) => ({ ...group, sections: getSectionsInGroup(group.key) }));
---

<BaseLayout
	title="About"
	description={PAGE_DESCRIPTIONS.about}
	currentPath={Astro.url.pathname}
	breadcrumbs={breadcrumbs}
>
	<div class="container section-page">
		<PageHeader
			breadcrumbs={breadcrumbs}
			label="About"
			title="About Digital Catholic"
			intro="Digital Catholic is a free library that shares the Catholic faith in clear, accessible language—for prayer, formation, catechesis, and everyday reading."
		/>

		<div class="split">
			<div class="prose">
				<h2>What Digital Catholic is</h2>
				<p>
					We publish articles drawn from Scripture and the teaching of the Church: lives of the saints
					and apostles, the sacraments, summaries of every book of the Bible, traditional prayers, the
					Rosary, and the seasons and feasts of the liturgical year. Each article can be read on its
					own or shared with family, students, and friends.
				</p>

				<h2>Who it is for</h2>
				<ul>
					<li>Catholics who want to understand and pray their faith more deeply.</li>
					<li>Catechists, parents, and teachers looking for clear material to share.</li>
					<li>Anyone preparing for a sacrament, or simply curious about what Catholics believe.</li>
				</ul>

				<h2>What you can learn and do</h2>
				<p>
					Read a saint’s biography on their feast day, follow the Church year in the liturgical
					calendar, learn how to pray the Rosary step by step, discover what each object at Mass
					means, or explore the miracles and parables of Jesus with their Gospel references.
				</p>

				<h2>How the content is organized</h2>
				<p>
					The library has <strong>{siteSections.length} content areas</strong> grouped into three
					pathways:
				</p>
				<dl class="about-groups">
					{groups.map((group) => (
						<div class="about-groups__item">
							<dt>{group.label}</dt>
							<dd>{group.sections.map((s) => s.title).join(', ')}</dd>
						</div>
					))}
				</dl>

				<h2>Our approach to accuracy and devotion</h2>
				<p>
					We aim for accuracy and reverence in presenting what Catholics believe. Articles on Marian
					apparitions and Eucharistic miracles carry a Church status label that reflects only what
					the article itself reports—approved for devotion, recognized or permitted, historical
					tradition, or reported without a formal judgment. The Church never requires belief in a
					private revelation.
				</p>
				<p>
					Content is offered for knowledge and devotion, not as a substitute for the Magisterium, your
					parish, or spiritual direction. If you spot an error, please
					<a href={withBase('/contact')}>let us know</a>.
				</p>

				<h2>Features</h2>
				<ul class="feature-list">
					<li>
						<strong>Site search.</strong> Find saints, apostles, sacraments, Bible summaries, prayers,
						commandments, calendar entries, and Rosary mysteries from any page. Press
						<kbd>/</kbd> to open it.
					</li>
					<li>
						<strong>Dark theme.</strong> The site uses a single, easy-on-the-eyes dark theme.
					</li>
					<li>
						<strong>Responsive and accessible.</strong> Pages work on phones, tablets, and desktops, and
						every control can be used with a keyboard.
					</li>
				</ul>
			</div>

			<aside class="split__aside" aria-label="Illustration and site sections">
				{image && (
					<figure class="framed-figure">
						<img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
						<figcaption>Sermon on the Mount — Carl Heinrich Bloch</figcaption>
					</figure>
				)}
				<div class="stat-row">
					<div class="stat">
						<span class="stat__value">{siteSections.length}</span>
						<span class="stat__label">Content areas</span>
					</div>
					<div class="stat">
						<span class="stat__value">Free</span>
						<span class="stat__label">Always open</span>
					</div>
				</div>
				<nav class="aside-panel" aria-labelledby="about-sections-title">
					<h2 class="aside-panel__title" id="about-sections-title">Browse every section</h2>
					<ul class="aside-panel__list">
						{siteSections.map((section) => (
							<li>
								<a href={withBase(section.href)}>
									<span class="aside-panel__name">{section.title}</span>
									<span class="aside-panel__blurb">{section.blurb}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			</aside>
		</div>
	</div>
</BaseLayout>
