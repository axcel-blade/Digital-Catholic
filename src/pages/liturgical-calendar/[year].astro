---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBack from '../../components/PageBack.astro';
import LiturgicalCalendarView from '../../components/LiturgicalCalendarView.astro';
import {
	buildLiturgicalYear,
	getLiturgicalYearsRange,
	liturgicalCalendarIntro,
	liturgicalSeasonsIntro,
} from '../../data/liturgical-calendar';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
	const defaultYear = new Date().getFullYear();
	return getLiturgicalYearsRange(defaultYear, 1, 2)
		.filter((year) => year !== defaultYear)
		.map((year) => ({
			params: { year: String(year) },
		}));
}

const { year: yearParam } = Astro.params;
const year = Number(yearParam);
const currentPath = Astro.url.pathname;
const defaultYear = new Date().getFullYear();
const yearData = buildLiturgicalYear(year);
const yearOptions = getLiturgicalYearsRange(defaultYear, 1, 2);
---

<BaseLayout
	title={`Liturgical Calendar ${year}`}
	description={PAGE_DESCRIPTIONS.liturgicalCalendar}
	currentPath={currentPath}
>
	<div class="page-content page-content--catalog page-content--liturgical">
		<PageBack href={withBase('/liturgical-calendar')} />
		<div class="catalog-hero">
			<p class="hero__tagline">Worship & Prayer</p>
			<h1>Catholic Liturgical Calendar {year}</h1>
			<p class="lead">{liturgicalCalendarIntro}</p>
			<p class="catalog-prose">{liturgicalSeasonsIntro}</p>
		</div>

		<LiturgicalCalendarView
			yearData={yearData}
			yearOptions={yearOptions}
			defaultYear={defaultYear}
		/>
	</div>
</BaseLayout>
