---
import SectionLayout from '../../layouts/SectionLayout.astro';
import LiturgicalCalendarView from '../../components/LiturgicalCalendarView.astro';
import {
	buildLiturgicalYear,
	getLiturgicalYearsRange,
	liturgicalCalendarIntro,
	liturgicalSeasonsIntro,
} from '../../data/liturgical-calendar';

export function getStaticPaths() {
	const defaultYear = new Date().getFullYear();
	return getLiturgicalYearsRange(defaultYear, 1, 2)
		.filter((year) => year !== defaultYear)
		.map((year) => ({ params: { year: String(year) } }));
}

const year = Number(Astro.params.year);
const defaultYear = new Date().getFullYear();
const yearData = buildLiturgicalYear(year);
const yearOptions = getLiturgicalYearsRange(defaultYear, 1, 2);
---

<SectionLayout
	sectionKey="liturgical-calendar"
	heading={`Catholic Liturgical Calendar ${year}`}
	title={`Liturgical Calendar ${year}`}
	description={`The Catholic liturgical calendar for ${year}—the date of Easter, the seasons of the Church year, and the solemnities, feasts, and memorials of the General Roman Calendar.`}
	currentPath={Astro.url.pathname}
	intro={liturgicalCalendarIntro}
	pageCrumb={String(year)}
>
	<p class="page-header__secondary" slot="header">{liturgicalSeasonsIntro}</p>
	<LiturgicalCalendarView yearData={yearData} yearOptions={yearOptions} defaultYear={defaultYear} />
</SectionLayout>
