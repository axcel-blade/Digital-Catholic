---
import SectionLayout from '../../layouts/SectionLayout.astro';
import LiturgicalCalendarView from '../../components/LiturgicalCalendarView.astro';
import {
	buildLiturgicalYear,
	getLiturgicalYearsRange,
	liturgicalCalendarIntro,
	liturgicalSeasonsIntro,
} from '../../data/liturgical-calendar';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';

const defaultYear = new Date().getFullYear();
const yearData = buildLiturgicalYear(defaultYear);
const yearOptions = getLiturgicalYearsRange(defaultYear, 1, 2);
---

<SectionLayout
	sectionKey="liturgical-calendar"
	heading={`Catholic Liturgical Calendar ${defaultYear}`}
	title="Liturgical Calendar"
	description={PAGE_DESCRIPTIONS.liturgicalCalendar}
	currentPath={Astro.url.pathname}
	intro={liturgicalCalendarIntro}
>
	<p class="page-header__secondary" slot="header">{liturgicalSeasonsIntro}</p>
	<LiturgicalCalendarView yearData={yearData} yearOptions={yearOptions} defaultYear={defaultYear} />
</SectionLayout>
