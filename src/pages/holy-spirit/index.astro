---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ReferenceLine from '../../components/ReferenceLine.astro';
import { fruitsIntro, giftsIntro, spiritFruits, spiritGifts } from '../../data/holy-spirit';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
---

<SectionLayout
	sectionKey="learn"
	heading="Gifts and Fruits of the Holy Spirit"
	extraCrumbs={[{ label: 'Holy Trinity', href: withBase('/holy-trinity') }]}
	pageCrumb="Gifts and Fruits of the Holy Spirit"
	description={PAGE_DESCRIPTIONS.holySpirit}
	currentPath={Astro.url.pathname}
	intro="The Holy Spirit pours out seven gifts that make us docile to His promptings, and as we follow Him, His life in us bears fruit. The gifts are given to every Christian in Baptism and strengthened in Confirmation; the fruits are the perfections the Spirit forms in us as the first fruits of eternal glory (CCC 1830–1832)."
	count={`${spiritGifts.length} gifts · ${spiritFruits.length} fruits`}
>
	<nav class="jump-links" aria-label="Jump to a part of this page" slot="header">
		<a class="jump-links__link" href="#gifts">The Seven Gifts</a>
		<a class="jump-links__link" href="#fruits">The Twelve Fruits</a>
	</nav>

	<section class="page-section" aria-labelledby="gifts">
		<h2 class="section-title" id="gifts">The Seven Gifts of the Holy Spirit</h2>
		<p class="section-intro">{giftsIntro}</p>
		<ReferenceLine scripture="Isaiah 11:1–3; 1 Corinthians 12:4–11" catechism="CCC 1830–1831" />
		<ol class="numbered-list">
			{spiritGifts.map((gift) => (
				<li class="numbered-item" id={`gift-${gift.number}`}>
					<span class="numbered-item__number" aria-hidden="true">{gift.number}</span>
					<div class="numbered-item__body">
						<h3 class="numbered-item__title">
							<span class="visually-hidden">Gift {gift.number}: </span>{gift.title}
						</h3>
						<blockquote class="numbered-item__quote">{gift.summary}</blockquote>
						<p class="numbered-item__text">{gift.meaning}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="page-section" aria-labelledby="fruits">
		<h2 class="section-title" id="fruits">The Twelve Fruits of the Holy Spirit</h2>
		<p class="section-intro">{fruitsIntro}</p>
		<ReferenceLine scripture="Galatians 5:22–23" catechism="CCC 1832" />
		<ol class="numbered-list">
			{spiritFruits.map((fruit) => (
				<li class="numbered-item" id={`fruit-${fruit.number}`}>
					<span class="numbered-item__number" aria-hidden="true">{fruit.number}</span>
					<div class="numbered-item__body">
						<h3 class="numbered-item__title">
							<span class="visually-hidden">Fruit {fruit.number}: </span>{fruit.title}
						</h3>
						<p class="numbered-item__text">{fruit.meaning}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<p class="section-footer-links">
		Continue with the <a href={withBase('/sacraments/confirmation')}>sacrament of Confirmation</a>, which strengthens
		these gifts, or the <a href={withBase('/bible/galatians')}>Letter to the Galatians</a>, where St. Paul names the fruits of the Spirit.
	</p>
</SectionLayout>
