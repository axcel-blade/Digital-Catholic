---
import SectionLayout from '../../layouts/SectionLayout.astro';
import {
	bibleBooks,
	bibleCategoryLabels,
	bibleIntro,
	getBibleBooksByCategory,
	newTestamentCategoryOrder,
	oldTestamentCategoryOrder,
	testamentLabels,
} from '../../data/bible';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';

const testaments = [
	{ key: 'old' as const, id: 'old-testament', order: oldTestamentCategoryOrder },
	{ key: 'new' as const, id: 'new-testament', order: newTestamentCategoryOrder },
].map((testament) => {
	const categories = testament.order.map((category) => ({
		category,
		label: bibleCategoryLabels[category],
		books: getBibleBooksByCategory(testament.key, category),
	}));
	return {
		...testament,
		label: testamentLabels[testament.key],
		categories,
		count: categories.reduce((sum, c) => sum + c.books.length, 0),
	};
});
const deuterocanonicalCount = bibleBooks.filter((b) => b.deuterocanonical).length;
---

<SectionLayout
	sectionKey="bible"
	description={PAGE_DESCRIPTIONS.bible}
	currentPath={Astro.url.pathname}
	intro={bibleIntro}
	count={`${bibleBooks.length} books · ${testaments[0].count} Old Testament · ${testaments[1].count} New Testament`}
>
	<nav class="jump-links" aria-label="Jump to testament" slot="header">
		{testaments.map((t) => (
			<a class="jump-links__link" href={`#${t.id}`}>{t.label} <span class="jump-links__count">{t.count}</span></a>
		))}
	</nav>

	<p class="callout callout--scripture">
		The Catholic canon includes {deuterocanonicalCount} deuterocanonical books, received by the Church
		from antiquity. They are marked below.
	</p>

	{testaments.map((testament) => (
		<section class="bible-testament" id={testament.id} aria-labelledby={`${testament.id}-title`}>
			<h2 class="section-title" id={`${testament.id}-title`}>{testament.label}</h2>
			{testament.categories.map((group) => (
				<div class="bible-category">
					<h3 class="bible-category__title">
						{group.label} <span class="bible-category__count">{group.books.length}</span>
					</h3>
					<ul class="book-list">
						{group.books.map((book) => (
							<li class="book-item">
								<span class="book-item__abbr" aria-hidden="true">{book.abbreviation}</span>
								<div class="book-item__body">
									<h4 class="book-item__title">
										<a class="book-item__link" href={withBase(`/bible/${book.slug}`)}>{book.title}</a>
									</h4>
									{book.deuterocanonical && <span class="tag tag--scripture">Deuterocanonical</span>}
									<p class="book-item__excerpt">{book.excerpt}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			))}
		</section>
	))}
</SectionLayout>
