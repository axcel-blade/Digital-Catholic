---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { bibleBooks, bibleFormationIntro, bibleFormationSections } from '../../data/bible';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getPublicImage } from '../../lib/images';
import type { ArticleLink } from '../../lib/article';

const image = getPublicImage(
	'/bible/how-the-bible-was-formed.jpg',
	'Saint Jerome writing at a table with open books and a skull, oil painting by Caravaggio (public domain)'
);

const related: ArticleLink[] = ['genesis', 'matthew', 'wisdom']
	.map((slug) => bibleBooks.find((b) => b.slug === slug))
	.filter((b) => b !== undefined)
	.map((book) => ({
		href: withBase(`/bible/${book.slug}`),
		title: book.title,
		label: 'Book of the Bible',
		excerpt: book.excerpt,
	}));
---

<ArticleLayout
	title="How the Bible Was Formed"
	description={PAGE_DESCRIPTIONS.bibleFormation}
	currentPath={Astro.url.pathname}
	sectionKey="bible"
	label="Bible · History"
	lead={bibleFormationIntro}
	sections={bibleFormationSections}
	related={related}
	image={image}
	imageCaption="Saint Jerome Writing, Caravaggio (c. 1605–1606). St. Jerome translated the Scriptures into Latin."
>
	<SectionList sections={bibleFormationSections} />
	<p class="callout callout--scripture">
		Ready to read? See <a href={withBase('/bible')}>all seventy-three books of the Catholic Bible</a>.
	</p>
</ArticleLayout>
