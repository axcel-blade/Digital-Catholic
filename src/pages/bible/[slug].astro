---
import ArticleLayout, { type ArticleMeta } from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import {
	bibleBooks,
	bibleCategoryLabels,
	testamentLabels,
	type BibleBook,
} from '../../data/bible';
import { withBase } from '../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return bibleBooks.map((book) => ({ params: { slug: book.slug } }));
}

const index = bibleBooks.findIndex((b) => b.slug === Astro.params.slug);
const book = bibleBooks[index];

if (!book) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (b: BibleBook): ArticleLink => ({
	href: withBase(`/bible/${b.slug}`),
	title: b.title,
	label: bibleCategoryLabels[b.category],
	excerpt: b.excerpt,
});

const { prev, next } = getNeighbors(bibleBooks, index);
const meta: ArticleMeta[] = [
	{ term: 'Testament', value: testamentLabels[book.testament] },
	{ term: 'Section', value: bibleCategoryLabels[book.category] },
	{ term: 'Abbreviation', value: book.abbreviation },
	...(book.deuterocanonical ? [{ term: 'Canon', value: 'Deuterocanonical' }] : []),
];

// Every book links to its full text in the USCCB's New American Bible unless the data names its own sources
const trust = {
	...book,
	sources: book.sources ?? [
		{
			label: `${book.title} (USCCB New American Bible)`,
			url: `https://bible.usccb.org/bible/${book.slug.replace(/-/g, '')}/1`,
		},
	],
};
---

<ArticleLayout
	title={book.title}
	description={book.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="learn"
	extraCrumbs={[{ label: 'Holy Bible', href: withBase('/bible') }]}
	label={`Scripture · ${testamentLabels[book.testament]}`}
	lead={book.excerpt}
	meta={meta}
	sections={book.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(bibleBooks, index, 3, (b) => b.category).map(toLink)}
	trust={trust}
>
	<SectionList sections={book.sections} />
	{book.deuterocanonical && (
		<p class="callout">
			{book.title} is one of the Deuterocanonical books, found in Catholic and Orthodox Bibles but usually left out of
			Protestant ones. Read <a href={withBase('/bible-and-tradition#topic-4')}>why Catholic Bibles include them</a> and
			<a href={withBase('/bible/how-the-bible-was-formed')}>how the canon was formed</a>.
		</p>
	)}
	<p class="callout callout--scripture">
		This summary introduces the book; read the full text in a Catholic Bible translation such as the
		NABRE or RSV-2CE. Browse the <a href={withBase('/bible')}>complete canon</a> or explore the
		<a href={withBase('/parables')}>parables</a> and <a href={withBase('/miracles')}>miracles of Jesus</a>.
	</p>
</ArticleLayout>
