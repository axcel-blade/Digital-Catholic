---
import GuideArticle from '../../components/GuideArticle.astro';
import { getGuide } from '../../data/guides';
import { slugify } from '../../lib/article';

export function getStaticPaths() {
	return getGuide('apologetics').topics.map((topic) => ({ params: { slug: slugify(topic.title) } }));
}
---

<GuideArticle guideKey="apologetics" slug={Astro.params.slug!} />
