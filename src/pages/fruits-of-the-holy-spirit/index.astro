---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ReferenceLine from '../../components/ReferenceLine.astro';
import { fruitsIntro, spiritFruits } from '../../data/holySpirit';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
---

<SectionLayout
	sectionKey="fruits-of-the-holy-spirit"
	heading="The Twelve Fruits of the Holy Spirit"
	title="Fruits of the Holy Spirit"
	description={PAGE_DESCRIPTIONS.fruitsOfTheHolySpirit}
	currentPath={Astro.url.pathname}
	intro={fruitsIntro}
	count={`${spiritFruits.length} fruits`}
>
	<nav class="jump-links jump-links--numbers" aria-label="Jump to a fruit" slot="header">
		{spiritFruits.map((f) => (
			<a class="jump-links__link" href={`#fruit-${f.number}`}>
				<span class="visually-hidden">Fruit </span>{f.number}
			</a>
		))}
	</nav>

	<ReferenceLine scripture="Galatians 5:22–23" catechism="CCC 1832" />

	<ol class="numbered-list">
		{spiritFruits.map((fruit) => (
			<li class="numbered-item" id={`fruit-${fruit.number}`}>
				<span class="numbered-item__number" aria-hidden="true">{fruit.number}</span>
				<div class="numbered-item__body">
					<h2 class="numbered-item__title">
						<span class="visually-hidden">Fruit {fruit.number}: </span>{fruit.title}
					</h2>
					<p class="numbered-item__text">{fruit.meaning}</p>
				</div>
			</li>
		))}
	</ol>

	<p class="section-footer-links">
		Continue with the <a href={withBase('/gifts-of-the-holy-spirit')}>Gifts of the Holy Spirit</a> or the
		<a href={withBase('/bible/galatians')}>Letter to the Galatians</a>, where St. Paul names the fruits of the Spirit.
	</p>
</SectionLayout>
