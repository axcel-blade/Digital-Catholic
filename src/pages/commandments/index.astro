---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { commandments, commandmentsIntro } from '../../data/commandments';

const currentPath = Astro.url.pathname;
---

<BaseLayout
	title="Ten Commandments"
	description="The Ten Commandments of God — moral law given to Moses, taught by the Catholic Church for love of God and neighbor."
	currentPath={currentPath}
>
	<div class="page-content page-content--wide">
		<p class="hero__tagline">Faith & Moral Life</p>
		<h1>The Ten Commandments</h1>
		<p class="lead">{commandmentsIntro}</p>

		<ol class="commandment-list">
			{commandments.map((commandment) => (
				<li class="commandment-card" id={`commandment-${commandment.number}`}>
					<div class="commandment-card__header">
						<span class="commandment-card__number">{commandment.number}</span>
						<h2 class="commandment-card__title">{commandment.title}</h2>
					</div>
					<blockquote class="commandment-card__text">“{commandment.text}”</blockquote>
					<p class="commandment-card__meaning">{commandment.meaning}</p>
				</li>
			))}
		</ol>
	</div>
</BaseLayout>
