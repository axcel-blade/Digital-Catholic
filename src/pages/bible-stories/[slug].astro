---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { bibleStories, type BibleStory } from '../../data/bible-stories';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return bibleStories.map((story) => ({ params: { slug: story.slug } }));
}

const index = bibleStories.findIndex((p) => p.slug === Astro.params.slug);
const story = bibleStories[index];

if (!story) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (p: BibleStory): ArticleLink => ({
	href: withBase(`/bible-stories/${p.slug}`),
	title: p.title,
	label: p.era,
	excerpt: p.excerpt,
});

const { prev, next } = getNeighbors(bibleStories, index);
---

<ArticleLayout
	title={story.title}
	description={story.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="learn"
	extraCrumbs={[{ label: 'Bible Stories', href: withBase('/bible-stories') }]}
	label={`Bible story · ${story.era}`}
	lead={story.excerpt}
	meta={[{ term: 'Scripture', value: story.scriptureReference }]}
	image={getCollectionImage('bible-stories', story.slug, story.imageAlt)}
	sections={story.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(bibleStories, index, 3, (p) => p.era).map(toLink)}
	trust={story}
>
	<SectionList sections={story.sections} />
</ArticleLayout>
