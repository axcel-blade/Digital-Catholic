---
import ArticleLayout, { type ArticleMeta } from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { disciples, getDiscipleImageAlt, type Disciple } from '../../data/disciples';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return disciples.map((disciple) => ({ params: { slug: disciple.slug } }));
}

const index = disciples.findIndex((d) => d.slug === Astro.params.slug);
const disciple = disciples[index];

if (!disciple) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (d: Disciple): ArticleLink => ({
	href: withBase(`/disciples/${d.slug}`),
	title: d.title,
	label: 'Apostle',
	excerpt: d.excerpt,
});

const { prev, next } = getNeighbors(disciples, index);
const meta: ArticleMeta[] = [
	...(disciple.alsoKnownAs ? [{ term: 'Also known as', value: disciple.alsoKnownAs }] : []),
	...(disciple.lifeDates ? [{ term: 'Life', value: disciple.lifeDates }] : []),
	...(disciple.feastDays ? [{ term: 'Feast days', value: disciple.feastDays }] : []),
	{ term: 'Scripture', value: disciple.gospelReference },
];
---

<ArticleLayout
	title={disciple.title}
	description={disciple.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="disciples"
	label="Apostle · Disciple of Jesus"
	lead={disciple.excerpt}
	meta={meta}
	image={getCollectionImage('disciples', disciple.slug, getDiscipleImageAlt(disciple.title))}
	sections={disciple.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(disciples, index).map(toLink)}
	trust={disciple}
>
	<SectionList sections={disciple.sections} />
</ArticleLayout>
