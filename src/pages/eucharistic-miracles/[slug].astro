---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { eucharisticMiracles, type EucharisticMiracle } from '../../data/eucharisticMiracles';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return eucharisticMiracles.map((miracle) => ({ params: { slug: miracle.slug } }));
}

const index = eucharisticMiracles.findIndex((m) => m.slug === Astro.params.slug);
const miracle = eucharisticMiracles[index];

if (!miracle) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (m: EucharisticMiracle): ArticleLink => ({
	href: withBase(`/eucharistic-miracles/${m.slug}`),
	title: m.title,
	label: m.location,
	excerpt: m.excerpt,
});

const { prev, next } = getNeighbors(eucharisticMiracles, index);
---

<ArticleLayout
	title={miracle.title}
	description={miracle.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="eucharistic-miracles"
	label={`Eucharistic miracle · ${miracle.category}`}
	lead={miracle.excerpt}
	meta={[
		{ term: 'Place', value: miracle.location },
		{ term: 'Date', value: miracle.date },
	]}
	image={getCollectionImage('eucharistic-miracles', miracle.slug, miracle.imageAlt)}
	sections={miracle.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(eucharisticMiracles, index, 3, (m) => m.category).map(toLink)}
	trust={miracle}
>
	<SectionList sections={miracle.sections} />
</ArticleLayout>
