---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import CardFilter from '../../components/CardFilter.astro';
import StatusLegend from '../../components/StatusLegend.astro';
import EmptyState from '../../components/EmptyState.astro';
import { eucharisticMiracles, eucharisticMiraclesIntro } from '../../data/eucharisticMiracles';
import { churchStatusLabels, churchStatusOrder } from '../../data/lib/trust';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';

const statuses = churchStatusOrder.filter((status) =>
	eucharisticMiracles.some((m) => m.churchStatus === status)
);
const statusOptions = statuses.map((status) => ({
	value: status,
	label: churchStatusLabels[status],
	count: eucharisticMiracles.filter((m) => m.churchStatus === status).length,
}));
---

<SectionLayout
	sectionKey="eucharistic-miracles"
	heading="Eucharistic Miracles"
	description={PAGE_DESCRIPTIONS.eucharisticMiracles}
	currentPath={Astro.url.pathname}
	intro={eucharisticMiraclesIntro}
	count={`${eucharisticMiracles.length} accounts`}
>
	<Fragment slot="header">
		{statuses.length > 0 && <StatusLegend statuses={statuses} />}
	</Fragment>

	{eucharisticMiracles.length === 0 ? (
		<EmptyState />
	) : (
		<>
			{statusOptions.length > 1 && (
				<CardFilter
					target="eucharistic-list"
					label="Filter by Church status"
					options={statusOptions}
					noun={{ one: 'account', many: 'accounts' }}
				/>
			)}
			<ul class="card-grid card-grid--media" id="eucharistic-list">
				{eucharisticMiracles.map((miracle, i) => (
					<EntryCard
						href={withBase(`/eucharistic-miracles/${miracle.slug}`)}
						title={miracle.title}
						label={miracle.category}
						meta={`${miracle.location} · ${miracle.date}`}
						status={miracle.churchStatus}
						excerpt={miracle.excerpt}
						action="Read article"
						image={getCollectionImage('eucharistic-miracles', miracle.slug, miracle.imageAlt)}
						filterValue={miracle.churchStatus}
						eager={i < 3}
					/>
				))}
			</ul>
		</>
	)}
	<p class="section-footer-links">
		See also the <a href={withBase('/sacraments/eucharist')}>sacrament of the Eucharist</a>,
		<a href={withBase('/marian-apparitions')}>Marian apparitions</a>, and the
		<a href={withBase('/miracles')}>miracles of Jesus in the Gospels</a>.
	</p>
</SectionLayout>
