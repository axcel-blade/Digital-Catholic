---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { massIntro, massPages } from '../../data/mass';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
---

<SectionLayout
	sectionKey="mass"
	description={PAGE_DESCRIPTIONS.mass}
	currentPath={Astro.url.pathname}
	intro={massIntro}
	count={`${massPages.length} guides`}
>
	<ul class="card-grid card-grid--two">
		{massPages.map((page) => (
			<EntryCard
				href={withBase(page.href)}
				title={page.title}
				label="Mass"
				excerpt={page.excerpt}
				action={page.action}
			/>
		))}
	</ul>

	<p class="section-footer-links">
		See also the <a href={withBase('/sacraments/eucharist')}>sacrament of the Eucharist</a> and the
		<a href={withBase('/liturgical-calendar')}>liturgical calendar</a>, which sets the color of each day.
	</p>
</SectionLayout>
