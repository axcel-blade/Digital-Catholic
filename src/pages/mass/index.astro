---
import GuidePage from '../../components/GuidePage.astro';
import EntryCard from '../../components/EntryCard.astro';
import { massIntro, massPages } from '../../data/mass';
import { getGuide } from '../../data/guides';
import { liturgicalCalendarIntro } from '../../data/liturgical-calendar';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';

const liturgy = getGuide('mass');
---

<GuidePage
	guideKey="mass"
	sectionKey="pray"
	heading="Holy Mass and Liturgy"
	description={PAGE_DESCRIPTIONS.mass}
	intro={`${massIntro} ${liturgy.intro}`}
	count={`${massPages.length} guides · ${liturgy.topics.length} topics`}
>
	<section slot="lead" aria-labelledby="mass-guides">
		<h2 id="mass-guides">The Mass step by step</h2>
		<ul class="card-grid card-grid--two">
			{massPages.map((page) => (
				<EntryCard
					href={withBase(page.href)}
					title={page.title}
					label="Mass"
					excerpt={page.excerpt}
					action={page.action}
				/>
			))}
		</ul>
		<h2 id="liturgical-calendar">The Liturgical Calendar</h2>
		<ul class="card-grid card-grid--two">
			<EntryCard
				href={withBase('/liturgical-calendar')}
				title="Liturgical Calendar"
				label="Liturgy"
				excerpt={liturgicalCalendarIntro}
				action="Open the calendar"
			/>
		</ul>
		<h2 id="liturgy">Understanding the liturgy</h2>
	</section>

	<p class="section-footer-links">
		See also the <a href={withBase('/sacraments/eucharist')}>sacrament of the Eucharist</a>.
	</p>
</GuidePage>
