---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_DESCRIPTIONS } from '../lib/seo';
import { withBase } from '../lib/paths';

const currentPath = Astro.url.pathname;

const topics = [
	{
		href: '/saints',
		category: 'Saints',
		title: 'Saint Biographies',
		excerpt:
			'Biographies of holy men and women whose lives witness to Christ and inspire us in prayer and daily living.',
		readLabel: 'Read biographies →',
	},
	{
		href: '/sacraments',
		category: 'Sacraments',
		title: 'The Seven Sacraments',
		excerpt:
			'Teaching on the seven sacraments—what they are, why they matter, and how they draw us into God’s grace.',
		readLabel: 'Read articles →',
	},
	{
		href: '/miracles',
		category: 'Gospels',
		title: 'Miracles of Jesus',
		excerpt:
			'Extraordinary signs in Matthew, Mark, Luke, and John that reveal Christ’s glory and call us to faith.',
		readLabel: 'Read the miracles →',
	},
	{
		href: '/parables',
		category: 'Gospels',
		title: 'Parables of Jesus',
		excerpt:
			'Stories of the Kingdom in the Gospels that teach mercy, prayer, discipleship, and the love of God.',
		readLabel: 'Read the parables →',
	},
	{
		href: '/commandments',
		category: 'Commandments',
		title: 'Ten Commandments',
		excerpt:
			'The moral law given to Moses—how we love God with our whole heart and our neighbor as ourselves.',
		readLabel: 'Read the Commandments →',
	},
	{
		href: '/rosary',
		category: 'Rosary',
		title: 'Mysteries of the Rosary',
		excerpt:
			'How to pray the Rosary, the traditional prayers, and the twenty mysteries for meditation.',
		readLabel: 'Read & pray →',
	},
];
---

<BaseLayout
	title="Digital Catholic"
	description={PAGE_DESCRIPTIONS.home}
	currentPath={currentPath}
>
	<div class="page-content page-content--catalog">
		<section class="catalog-hero">
			<p class="hero__tagline">Welcome</p>
			<h1>Digital Catholic</h1>
			<p class="lead">
				A place to explore the Catholic faith through the lives of the saints, the sacraments,
				and God’s law—shared clearly so everyone can learn and grow.
			</p>
		</section>

		<ul class="blog-grid blog-grid--catalog">
			{topics.map((topic) => (
				<li class="blog-card">
					<a class="blog-card__link" href={withBase(topic.href)}>
						<div class="blog-card__body">
							<span class="blog-card__category">{topic.category}</span>
							<h2 class="blog-card__title">{topic.title}</h2>
							<p class="blog-card__excerpt">{topic.excerpt}</p>
							<span class="blog-card__read">{topic.readLabel}</span>
						</div>
					</a>
				</li>
			))}
		</ul>

		<p class="home-about">
			<a class="cta-link" href={withBase('/about')}>Learn more about this site →</a>
		</p>
	</div>
</BaseLayout>
