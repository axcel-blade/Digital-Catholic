---
import RelatedTopics from '../../components/RelatedTopics.astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { coreBeliefs, coreBeliefsIntro } from '../../data/coreBeliefs';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { slugify } from '../../lib/article';

const articleHref = (title: string) => withBase(`/core-beliefs/${slugify(title)}`);
// Old in-page anchors from when every doctrine was on this page
const legacyAnchors = Object.fromEntries(coreBeliefs.map((b) => [`belief-${b.number}`, articleHref(b.title)]));
---

<SectionLayout
	sectionKey="learn"
	pageCrumb="Core Beliefs"
	heading="Core Catholic Beliefs"
	title="Core Catholic Beliefs"
	description={PAGE_DESCRIPTIONS.coreBeliefs}
	currentPath={Astro.url.pathname}
	intro={coreBeliefsIntro}
	count={`${coreBeliefs.length} doctrines`}
>
	<nav class="jump-links" aria-label="Jump to a doctrine" slot="header">
		{coreBeliefs.map((b) => (
			<a class="jump-links__link" href={articleHref(b.title)}>{b.title}</a>
		))}
	</nav>

	<script is:inline define:vars={{ legacyAnchors }}>
		const target = legacyAnchors[location.hash.slice(1)];
		if (target) location.replace(target);
	</script>

	<ul class="card-grid card-grid--two">
		{coreBeliefs.map((belief) => (
			<EntryCard
				href={articleHref(belief.title)}
				title={belief.title}
				label={`Doctrine ${belief.number}`}
				excerpt={belief.summary}
				action="Read the article"
			/>
		))}
	</ul>

	<RelatedTopics currentPath={Astro.url.pathname} text={coreBeliefs.flatMap((b) => [b.title, b.summary, ...b.meaning]).join(' ')} />

	<p class="section-footer-links">
		Continue with the <a href={withBase('/holy-trinity')}>Holy Trinity</a>, the
		<a href={withBase('/sacraments')}>Sacraments</a>, or the
		<a href={withBase('/commandments')}>Ten Commandments</a>, which show how these beliefs are lived.
	</p>
</SectionLayout>
