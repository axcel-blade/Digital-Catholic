---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { mysterySets, rosaryOriginIntro, rosaryOriginSections } from '../../data/rosary';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import type { ArticleLink } from '../../lib/article';

const related: ArticleLink[] = [
	{
		href: withBase('/rosary/promises'),
		title: 'The 15 Promises of the Rosary',
		label: 'Rosary · Devotion',
		excerpt:
			'Traditional spiritual blessings reportedly given by the Blessed Virgin Mary to Saint Dominic and Blessed Alan de la Roche.',
	},
	...mysterySets.slice(0, 2).map((set) => ({
		href: withBase(`/rosary/${set.slug}`),
		title: set.title,
		label: `Prayed on ${set.days}`,
		excerpt: set.excerpt,
	})),
];
---

<ArticleLayout
	title="Origin of the Rosary"
	description={PAGE_DESCRIPTIONS.rosaryOrigin}
	currentPath={Astro.url.pathname}
	sectionKey="pray"
	extraCrumbs={[{ label: 'Rosary', href: withBase('/rosary') }]}
	label="Rosary · History"
	lead={rosaryOriginIntro}
	sections={rosaryOriginSections}
	related={related}
>
	<SectionList sections={rosaryOriginSections} />
	<p class="callout callout--liturgy">
		Ready to pray? See <a href={withBase('/rosary')}>the mysteries, prayers, and how to recite the Rosary</a>.
	</p>
</ArticleLayout>
