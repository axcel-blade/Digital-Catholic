---
import SectionLayout from '../../layouts/SectionLayout.astro';
import {
	mysterySets,
	rosaryIntro,
	rosaryHowToIntro,
	rosaryHowToSteps,
	rosaryMysterySchedule,
	rosaryPrayers,
} from '../../data/rosary';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
---

<SectionLayout
	sectionKey="rosary"
	heading="Mysteries of the Rosary"
	description={PAGE_DESCRIPTIONS.rosary}
	currentPath={Astro.url.pathname}
	intro={rosaryIntro}
	count={`${mysterySets.length} sets of mysteries · ${mysterySets.reduce((n, s) => n + s.mysteries.length, 0)} mysteries`}
>
	<nav class="jump-links" aria-label="On this page" slot="header">
		<a class="jump-links__link" href="#how-to-recite">How to pray</a>
		<a class="jump-links__link" href="#rosary-prayers">The prayers</a>
		<a class="jump-links__link" href="#mysteries">The mysteries</a>
		<a class="jump-links__link" href={withBase('/rosary/origin')}>Origin of the Rosary</a>
	</nav>

	<section class="page-section" id="how-to-recite" aria-labelledby="how-to-recite-title">
		<h2 class="section-title" id="how-to-recite-title">How to pray the Rosary</h2>
		<p class="section-intro">{rosaryHowToIntro}</p>
		<ol class="step-list">
			{rosaryHowToSteps.map((step) => (
				<li class="step">
					<span class="step__number" aria-hidden="true">{step.number}</span>
					<div>
						<h3 class="step__title">{step.title}</h3>
						<p class="step__text">{step.description}</p>
					</div>
				</li>
			))}
		</ol>
		<p class="callout callout--liturgy">
			<strong>Which mysteries today?</strong>
			{rosaryMysterySchedule}
		</p>
	</section>

	<section class="page-section" id="rosary-prayers" aria-labelledby="rosary-prayers-title">
		<h2 class="section-title" id="rosary-prayers-title">Prayers of the Rosary</h2>
		<p class="section-intro">These are the words most often prayed while reciting the Rosary.</p>
		<ul class="prayer-list">
			{rosaryPrayers.map((prayer) => (
				<li class="prayer-card prayer-card--static">
					<h3 class="prayer-card__title">{prayer.title}</h3>
					<blockquote class="prayer-text prayer-text--card">{prayer.text}</blockquote>
				</li>
			))}
		</ul>
	</section>

	<section class="page-section" id="mysteries" aria-labelledby="mysteries-title">
		<h2 class="section-title" id="mysteries-title">The twenty mysteries</h2>
		<p class="section-intro">Choose a set to read each mystery with its fruit and a short meditation.</p>
		<ul class="card-grid card-grid--two">
			{mysterySets.map((set) => (
				<li class="card">
					<div class="card__body">
						<p class="card__label">Prayed on {set.days}</p>
						<h3 class="card__title">
							<a class="card__link" href={withBase(`/rosary/${set.slug}`)}>{set.title}</a>
						</h3>
						<p class="card__excerpt">{set.excerpt}</p>
						<span class="card__action" aria-hidden="true">View the five mysteries <span class="card__arrow">→</span></span>
					</div>
				</li>
			))}
		</ul>
	</section>
</SectionLayout>
