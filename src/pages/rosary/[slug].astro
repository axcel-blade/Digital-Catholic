---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { mysterySets, type MysterySet } from '../../data/rosary';
import { withBase } from '../../lib/paths';
import { getNeighbors, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return mysterySets.map((set) => ({ params: { slug: set.slug } }));
}

const index = mysterySets.findIndex((s) => s.slug === Astro.params.slug);
const set = mysterySets[index];

if (!set) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (s: MysterySet): ArticleLink => ({
	href: withBase(`/rosary/${s.slug}`),
	title: s.title,
	label: `Prayed on ${s.days}`,
	excerpt: s.excerpt,
});

const { prev, next } = getNeighbors(mysterySets, index);

// Where to read more about each mystery, keyed by "set-number"
const mysteryLinks: Record<string, { href: string; label: string }> = {
	'joyful-1': { href: '/saints/blessed-virgin-mary', label: 'The Blessed Virgin Mary' },
	'joyful-2': { href: '/prayers/hail-mary', label: 'The Hail Mary, drawn from Elizabeth’s greeting' },
	'joyful-3': { href: '/bible/luke', label: 'The Gospel of Luke' },
	'joyful-4': { href: '/bible/luke', label: 'The Gospel of Luke' },
	'joyful-5': { href: '/saints/st-joseph', label: 'St. Joseph' },
	'sorrowful-1': { href: '/pray/the-stations-of-the-cross', label: 'The Stations of the Cross' },
	'sorrowful-2': { href: '/pray/the-stations-of-the-cross', label: 'The Stations of the Cross' },
	'sorrowful-3': { href: '/pray/the-stations-of-the-cross', label: 'The Stations of the Cross' },
	'sorrowful-4': { href: '/pray/the-stations-of-the-cross', label: 'The Stations of the Cross' },
	'sorrowful-5': { href: '/core-beliefs', label: 'Core Catholic Beliefs: salvation' },
	'glorious-1': { href: '/miracles/the-resurrection', label: 'The Resurrection' },
	'glorious-2': { href: '/core-beliefs', label: 'The Resurrection and Ascension' },
	'glorious-3': { href: '/holy-spirit#gifts', label: 'Gifts of the Holy Spirit' },
	'glorious-4': { href: '/saints/topics/the-assumption-of-mary', label: 'The Assumption of Mary' },
	'glorious-5': { href: '/saints/blessed-virgin-mary', label: 'The Blessed Virgin Mary' },
	'luminous-1': { href: '/sacraments/baptism', label: 'The Sacrament of Baptism' },
	'luminous-2': { href: '/miracles/wedding-at-cana', label: 'The Wedding at Cana' },
	'luminous-3': { href: '/parables', label: 'The parables of the Kingdom' },
	'luminous-4': { href: '/miracles/the-transfiguration', label: 'The Transfiguration' },
	'luminous-5': { href: '/sacraments/eucharist', label: 'The Sacrament of the Eucharist' },
};
const related: ArticleLink[] = [
	...mysterySets.filter((s) => s.slug !== set.slug).map(toLink),
];
---

<ArticleLayout
	title={set.title}
	description={set.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="pray"
	extraCrumbs={[{ label: 'Rosary', href: withBase('/rosary') }]}
	label="Rosary"
	lead={set.intro}
	meta={[
		{ term: 'Prayed on', value: set.days },
		{ term: 'Mysteries', value: String(set.mysteries.length) },
	]}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={related}
	relatedText={set.mysteries.map((m) => `${m.title} ${m.meditation}`).join(' ')}
>
	<p>
		New to the Rosary? Read <a href={withBase('/rosary#how-to-recite')}>how to pray it</a> and
		<a href={withBase('/rosary#rosary-prayers')}>its prayers</a> first.
	</p>
	<ol class="numbered-list numbered-list--prose">
		{set.mysteries.map((mystery) => (
			<li class="numbered-item" id={`mystery-${mystery.number}`}>
				<span class="numbered-item__number" aria-hidden="true">{mystery.number}</span>
				<div class="numbered-item__body">
					<h2 class="numbered-item__title">
						<span class="visually-hidden">Mystery {mystery.number}: </span>{mystery.title}
					</h2>
					<p class="numbered-item__fruit"><strong>Fruit of the mystery:</strong> {mystery.fruit}</p>
					<p class="numbered-item__text">{mystery.meditation}</p>
					{mysteryLinks[`${set.slug}-${mystery.number}`] && (
						<p class="numbered-item__link">
							<a href={withBase(mysteryLinks[`${set.slug}-${mystery.number}`].href)}>
								{mysteryLinks[`${set.slug}-${mystery.number}`].label} →
							</a>
						</p>
					)}
				</div>
			</li>
		))}
	</ol>
</ArticleLayout>
