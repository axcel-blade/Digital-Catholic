---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { mysterySets, type MysterySet } from '../../data/rosary';
import { withBase } from '../../lib/paths';
import { getNeighbors, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return mysterySets.map((set) => ({ params: { slug: set.slug } }));
}

const index = mysterySets.findIndex((s) => s.slug === Astro.params.slug);
const set = mysterySets[index];

if (!set) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (s: MysterySet): ArticleLink => ({
	href: withBase(`/rosary/${s.slug}`),
	title: s.title,
	label: `Prayed on ${s.days}`,
	excerpt: s.excerpt,
});

const { prev, next } = getNeighbors(mysterySets, index);
const related: ArticleLink[] = [
	...mysterySets.filter((s) => s.slug !== set.slug).map(toLink),
];
---

<ArticleLayout
	title={set.title}
	description={set.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="rosary"
	label="Rosary"
	lead={set.intro}
	meta={[
		{ term: 'Prayed on', value: set.days },
		{ term: 'Mysteries', value: String(set.mysteries.length) },
	]}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={related}
>
	<p>
		New to the Rosary? Read <a href={withBase('/rosary#how-to-recite')}>how to pray it</a> and
		<a href={withBase('/rosary#rosary-prayers')}>its prayers</a> first.
	</p>
	<ol class="numbered-list numbered-list--prose">
		{set.mysteries.map((mystery) => (
			<li class="numbered-item" id={`mystery-${mystery.number}`}>
				<span class="numbered-item__number" aria-hidden="true">{mystery.number}</span>
				<div class="numbered-item__body">
					<h2 class="numbered-item__title">
						<span class="visually-hidden">Mystery {mystery.number}: </span>{mystery.title}
					</h2>
					<p class="numbered-item__fruit"><strong>Fruit of the mystery:</strong> {mystery.fruit}</p>
					<p class="numbered-item__text">{mystery.meditation}</p>
				</div>
			</li>
		))}
	</ol>
</ArticleLayout>
