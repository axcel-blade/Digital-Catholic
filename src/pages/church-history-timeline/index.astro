---
import SectionLayout from '../../layouts/SectionLayout.astro';
import CardFilter from '../../components/CardFilter.astro';
import { timelineEraLabels, timelineEraOrder, timelineEvents, timelineIntro } from '../../data/timeline';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';

const events = [...timelineEvents].sort((a, b) => a.year - b.year);
const options = timelineEraOrder.map((era) => ({
	value: era,
	label: timelineEraLabels[era],
	count: events.filter((e) => e.era === era).length,
}));
---

<SectionLayout
	sectionKey="study"
	heading="Church History Timeline"
	extraCrumbs={[
		{ label: 'Scripture, Tradition, and the Church', href: withBase('/bible-and-tradition') },
		{ label: 'Catholic Church History', href: withBase('/church-history') },
	]}
	pageCrumb="Timeline"
	description={PAGE_DESCRIPTIONS.churchHistoryTimeline}
	currentPath={Astro.url.pathname}
	intro={timelineIntro}
	count={`${events.length} milestones`}
>
	<CardFilter target="timeline" label="Show an era" options={options} noun={{ one: 'milestone', many: 'milestones' }} />

	<ol class="timeline" id="timeline">
		{events.map((event) => (
			<li class="timeline__event" data-filter-value={event.era}>
				<p class="timeline__date">{event.date}</p>
				<div class="timeline__body">
					<h2 class="timeline__title">{event.title}</h2>
					<p class="timeline__text">{event.description}</p>
					{event.link && (
						<p class="numbered-item__link">
							<a href={withBase(event.link.href)}>{event.link.label} →</a>
						</p>
					)}
				</div>
			</li>
		))}
	</ol>

	<p class="section-footer-links">
		Read the full story in <a href={withBase('/church-history')}>Catholic Church History</a>, or meet the people behind it in
		the <a href={withBase('/saints')}>Saints</a>.
	</p>
</SectionLayout>
