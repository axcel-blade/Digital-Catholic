---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBack from '../../components/PageBack.astro';
import {
	sacraments,
	getSacramentImageSrc,
	getSacramentImageAlt,
} from '../../data/sacraments';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';

const currentPath = Astro.url.pathname;
---

<BaseLayout
	title="Sacraments"
	description={PAGE_DESCRIPTIONS.sacraments}
	currentPath={currentPath}
>
	<div class="page-content page-content--catalog">
		<PageBack href={withBase('/')} />
		<div class="catalog-hero">
			<p class="hero__tagline">Sacraments</p>
			<h1>The Seven Sacraments</h1>
			<p class="lead">
				Explore each sacrament as a short article—what the Church teaches, how it is celebrated,
				and why it matters for your life in Christ.
			</p>
		</div>

		<ul class="blog-grid blog-grid--catalog blog-grid--media">
			{sacraments.map((sacrament) => (
				<li class="blog-card">
					<a class="blog-card__link" href={withBase(`/sacraments/${sacrament.slug}`)}>
						<div class="blog-card__media">
							<img
								src={getSacramentImageSrc(sacrament.slug)}
								alt={getSacramentImageAlt(sacrament.title)}
								width="640"
								height="400"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<div class="blog-card__body">
							<span class="blog-card__category">Sacrament</span>
							<h2 class="blog-card__title">{sacrament.title}</h2>
							<p class="blog-card__excerpt">{sacrament.excerpt}</p>
							<span class="blog-card__read">Read article →</span>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>
</BaseLayout>
