---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import {
	sacraments,
	sacramentGroupLabels,
	sacramentGuides,
	getSacramentImageAlt,
	getSacramentGuideImageAlt,
} from '../../data/sacraments';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';

const sacramentTitle = (slug: string) => sacraments.find((x) => x.slug === slug)?.title ?? slug;
---

<SectionLayout
	sectionKey="learn"
	pageCrumb="Sacraments"
	heading="The Seven Sacraments"
	title="Sacraments"
	description={PAGE_DESCRIPTIONS.sacraments}
	currentPath={Astro.url.pathname}
	intro="Explore each sacrament—what the Church teaches, how it is celebrated, and why it matters for your life in Christ. They are listed in the order of the Catechism: initiation, healing, and service of communion."
	count={`${sacraments.length} sacraments · ${sacramentGuides.length} in-depth guides`}
>
	<nav class="jump-links" aria-label="Jump to a part of this page" slot="header">
		<a class="jump-links__link" href="#in-depth">The Sacraments in Depth</a>
	</nav>

	{sacraments.length === 0 ? (
		<EmptyState />
	) : (
		<ul class="card-grid card-grid--media">
			{sacraments.map((sacrament, i) => (
				<EntryCard
					href={withBase(`/sacraments/${sacrament.slug}`)}
					title={sacrament.title}
					label={sacramentGroupLabels[sacrament.slug] ?? 'Sacrament'}
					excerpt={sacrament.excerpt}
					action="Read article"
					image={getCollectionImage('sacraments', sacrament.slug, getSacramentImageAlt(sacrament.title))}
					eager={i < 3}
				/>
			))}
		</ul>
	)}

	<section aria-labelledby="in-depth">
		<h2 id="in-depth">The Sacraments in Depth</h2>
		<p>
			Guides that go deeper into what the Church teaches about the sacraments and how to live them—from the Real
			Presence and transubstantiation to making a good Confession and receiving Communion worthily. Each guide links
			to the sacraments it explains.
		</p>
		{sacramentGuides.length === 0 ? (
			<EmptyState />
		) : (
			<ul class="card-grid card-grid--media">
				{sacramentGuides.map((guide) => (
					<EntryCard
						href={withBase(`/sacraments/guides/${guide.slug}`)}
						title={guide.title}
						label={guide.sacraments.map(sacramentTitle).join(' · ')}
						excerpt={guide.excerpt}
						action="Read guide"
						image={getCollectionImage('sacraments/guides', guide.slug, getSacramentGuideImageAlt(guide.title))}
					/>
				))}
			</ul>
		)}
	</section>
</SectionLayout>
