---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import {
	sacraments,
	sacramentGroupLabels,
	sacramentGuides,
	getSacramentImageAlt,
} from '../../data/sacraments';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
---

<SectionLayout
	sectionKey="sacraments"
	heading="The Seven Sacraments"
	title="Sacraments"
	description={PAGE_DESCRIPTIONS.sacraments}
	currentPath={Astro.url.pathname}
	intro="Explore each sacrament—what the Church teaches, how it is celebrated, and why it matters for your life in Christ. They are listed in the order of the Catechism: initiation, healing, and service of communion."
	count={`${sacraments.length} sacraments`}
>
	{sacraments.length === 0 ? (
		<EmptyState />
	) : (
		<ul class="card-grid card-grid--media">
			{sacraments.map((sacrament, i) => (
				<EntryCard
					href={withBase(`/sacraments/${sacrament.slug}`)}
					title={sacrament.title}
					label={sacramentGroupLabels[sacrament.slug] ?? 'Sacrament'}
					excerpt={sacrament.excerpt}
					action="Read article"
					image={getCollectionImage('sacraments', sacrament.slug, getSacramentImageAlt(sacrament.title))}
					eager={i < 3}
				/>
			))}
		</ul>
	)}

	<aside class="sacrament-guides" aria-labelledby="sacrament-guides-heading">
		<h2 id="sacrament-guides-heading">The Sacraments in Depth</h2>
		<p class="sacrament-guides__intro">
			Ready to go further? {sacramentGuides.length} in-depth guides explain the Real Presence, transubstantiation,
			Confession, marriage, Holy Orders, and more.
		</p>
		<a class="button button--secondary" href={withBase('/sacraments/guides')}>Explore the Sacraments in Depth</a>
	</aside>
</SectionLayout>
