---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import SectionList from '../../../components/SectionList.astro';
import {
	sacraments,
	sacramentGuides,
	getSacramentGuideImageAlt,
	type SacramentGuide,
} from '../../../data/sacraments';
import { getCollectionImage } from '../../../lib/images';
import { withBase } from '../../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../../lib/article';

export function getStaticPaths() {
	return sacramentGuides.map((guide) => ({ params: { slug: guide.slug } }));
}

const index = sacramentGuides.findIndex((g) => g.slug === Astro.params.slug);
const guide = sacramentGuides[index];

if (!guide) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (g: SacramentGuide): ArticleLink => ({
	href: withBase(`/sacraments/guides/${g.slug}`),
	title: g.title,
	label: 'Sacrament guide',
	excerpt: g.excerpt,
});

const { prev, next } = getNeighbors(sacramentGuides, index);
const relatedTeaching: Record<string, { href: string; title: string }[]> = {
	'baptism-and-confirmation': [
		{ href: '/holy-spirit#gifts', title: 'Gifts of the Holy Spirit' },
		{ href: '/study#topic-3', title: 'Why the Church baptises infants' },
	],
	'the-real-presence': [
		{ href: '/study#topic-2', title: 'Why Catholics believe in the Real Presence' },
		{ href: '/eucharistic-miracles', title: 'Eucharistic miracles' },
	],
	'transubstantiation-explained': [{ href: '/glossary#term-transubstantiation', title: 'Transubstantiation in the glossary' }],
	'confession-repentance-and-absolution': [
		{ href: '/moral-teaching#topic-5', title: 'Mortal and venial sin' },
		{ href: '/moral-teaching#topic-7', title: 'Forgiveness, mercy, repentance and reconciliation' },
		{ href: '/living-the-faith#topic-2', title: 'How to go to Confession (quick guide)' },
	],
	'the-sacrament-of-marriage': [{ href: '/living-the-faith#topic-5', title: 'Catholic dating, marriage and family life' }],
	'holy-orders-bishops-priests-and-deacons': [
		{ href: '/the-church#topic-3', title: 'Bishops, priests, deacons and the laity' },
		{ href: '/the-church#topic-4', title: 'Apostolic succession' },
		{ href: '/living-the-faith#topic-4', title: 'Discernment of vocation' },
	],
	'state-of-grace-and-worthy-reception': [
		{ href: '/moral-teaching#topic-5', title: 'Mortal and venial sin' },
		{ href: '/mass#topic-8', title: 'Proper reverence and participation at Mass' },
	],
};
const teaching = relatedTeaching[guide.slug] ?? [];
const relatedSacraments = guide.sacraments
	.map((slug) => sacraments.find((s) => s.slug === slug))
	.filter((s): s is NonNullable<typeof s> => Boolean(s));
---

<ArticleLayout
	title={guide.title}
	description={guide.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="learn"
	extraCrumbs={[{ label: 'Sacraments', href: withBase('/sacraments') }, { label: 'The Sacraments in Depth', href: withBase('/sacraments/guides') }]}
	label="Sacrament guide"
	lead={guide.excerpt}
	image={getCollectionImage('sacraments/guides', guide.slug, getSacramentGuideImageAlt(guide.title))}
	sections={guide.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(sacramentGuides, index, 3, (g) => g.sacraments[0]).map(toLink)}
	trust={guide}
>
	<SectionList sections={guide.sections} />
	{relatedSacraments.length > 0 && (
		<section class="article-section">
			<h2>{relatedSacraments.length === 1 ? 'The sacrament' : 'The sacraments'}</h2>
			<ul>
				{relatedSacraments.map((s) => (
					<li>
						<a href={withBase(`/sacraments/${s.slug}`)}>{s.title}</a> — {s.excerpt}
					</li>
				))}
				<li>
					<a href={withBase('/sacraments')}>The Seven Sacraments</a> — all seven sacraments in the order of the Catechism.
				</li>
			</ul>
		</section>
	)}
	{teaching.length > 0 && (
		<section class="article-section">
			<h2>Related teaching</h2>
			<ul>
				{teaching.map((t) => (
					<li><a href={withBase(t.href)}>{t.title}</a></li>
				))}
			</ul>
		</section>
	)}
</ArticleLayout>
