---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import SectionList from '../../../components/SectionList.astro';
import {
	sacraments,
	sacramentGuides,
	getSacramentGuideImageAlt,
	type SacramentGuide,
} from '../../../data/sacraments';
import { getCollectionImage } from '../../../lib/images';
import { withBase } from '../../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../../lib/article';

export function getStaticPaths() {
	return sacramentGuides.map((guide) => ({ params: { slug: guide.slug } }));
}

const index = sacramentGuides.findIndex((g) => g.slug === Astro.params.slug);
const guide = sacramentGuides[index];

if (!guide) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (g: SacramentGuide): ArticleLink => ({
	href: withBase(`/sacraments/guides/${g.slug}`),
	title: g.title,
	label: 'Sacrament guide',
	excerpt: g.excerpt,
});

const { prev, next } = getNeighbors(sacramentGuides, index);
const relatedSacraments = guide.sacraments
	.map((slug) => sacraments.find((s) => s.slug === slug))
	.filter((s): s is NonNullable<typeof s> => Boolean(s));
---

<ArticleLayout
	title={guide.title}
	description={guide.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="sacraments-in-depth"
	label="Sacrament guide"
	lead={guide.excerpt}
	image={getCollectionImage('sacraments/guides', guide.slug, getSacramentGuideImageAlt(guide.title))}
	sections={guide.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(sacramentGuides, index, 3, (g) => g.sacraments[0]).map(toLink)}
	trust={guide}
>
	<SectionList sections={guide.sections} />
	{relatedSacraments.length > 0 && (
		<section class="article-section">
			<h2>{relatedSacraments.length === 1 ? 'The sacrament' : 'The sacraments'}</h2>
			<ul>
				{relatedSacraments.map((s) => (
					<li>
						<a href={withBase(`/sacraments/${s.slug}`)}>{s.title}</a> — {s.excerpt}
					</li>
				))}
				<li>
					<a href={withBase('/sacraments')}>The Seven Sacraments</a> — all seven sacraments in the order of the Catechism.
				</li>
			</ul>
		</section>
	)}
</ArticleLayout>
