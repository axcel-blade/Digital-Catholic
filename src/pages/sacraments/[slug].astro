---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import {
	sacraments,
	sacramentGroupLabels,
	getSacramentImageAlt,
	getGuidesForSacrament,
	type Sacrament,
} from '../../data/sacraments';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return sacraments.map((sacrament) => ({ params: { slug: sacrament.slug } }));
}

const index = sacraments.findIndex((s) => s.slug === Astro.params.slug);
const sacrament = sacraments[index];

if (!sacrament) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const groupOf = (s: Sacrament) => sacramentGroupLabels[s.slug];
const toLink = (s: Sacrament): ArticleLink => ({
	href: withBase(`/sacraments/${s.slug}`),
	title: s.title,
	label: groupOf(s) ?? 'Sacrament',
	excerpt: s.excerpt,
});

const { prev, next } = getNeighbors(sacraments, index);
const guides = getGuidesForSacrament(sacrament.slug);

// Related pages elsewhere on the site, listed with the in-depth guides
const otherLinks: Record<string, { href: string; title: string; excerpt: string }[]> = {
	eucharist: [
		{ href: '/mass/order-of-mass', title: 'The Order of Mass', excerpt: 'Each part of the Mass, step by step.' },
		{ href: '/mass/items-used-at-mass', title: 'Items used at Mass', excerpt: 'The sacred vessels, altar linens, liturgical books, vestments, and colours used in celebrating the Eucharist.' },
	],
};
const extra = otherLinks[sacrament.slug] ?? [];
---

<ArticleLayout
	title={sacrament.title}
	description={sacrament.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="sacraments"
	label={groupOf(sacrament) ?? 'Sacrament'}
	lead={sacrament.excerpt}
	image={getCollectionImage('sacraments', sacrament.slug, getSacramentImageAlt(sacrament.title))}
	sections={sacrament.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(sacraments, index, 3, groupOf).map(toLink)}
	trust={sacrament}
>
	<SectionList sections={sacrament.sections} />
	{(guides.length > 0 || extra.length > 0) && (
		<section class="article-section">
			<h2>Go deeper</h2>
			<ul>
				{guides.map((guide) => (
					<li>
						<a href={withBase(`/sacraments/guides/${guide.slug}`)}>{guide.title}</a> — {guide.excerpt}
					</li>
				))}
				{extra.map((link) => (
					<li>
						<a href={withBase(link.href)}>{link.title}</a> — {link.excerpt}
					</li>
				))}
			</ul>
		</section>
	)}
</ArticleLayout>
