---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import {
	sacraments,
	sacramentGroupLabels,
	getSacramentImageAlt,
	getGuidesForSacrament,
	type Sacrament,
} from '../../data/sacraments';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return sacraments.map((sacrament) => ({ params: { slug: sacrament.slug } }));
}

const index = sacraments.findIndex((s) => s.slug === Astro.params.slug);
const sacrament = sacraments[index];

if (!sacrament) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const groupOf = (s: Sacrament) => sacramentGroupLabels[s.slug];
const toLink = (s: Sacrament): ArticleLink => ({
	href: withBase(`/sacraments/${s.slug}`),
	title: s.title,
	label: groupOf(s) ?? 'Sacrament',
	excerpt: s.excerpt,
});

const { prev, next } = getNeighbors(sacraments, index);
const guides = getGuidesForSacrament(sacrament.slug);

// Related pages elsewhere on the site, listed with the in-depth guides
const otherLinks: Record<string, { href: string; title: string; excerpt: string }[]> = {
	baptism: [
		{ href: '/apologetics#topic-3', title: 'Why the Church baptises infants', excerpt: 'Scripture and the early Church on infant Baptism.' },
	],
	confirmation: [
		{ href: '/gifts-of-the-holy-spirit', title: 'Gifts of the Holy Spirit', excerpt: 'The seven gifts strengthened in Confirmation.' },
		{ href: '/fruits-of-the-holy-spirit', title: 'Fruits of the Holy Spirit', excerpt: 'The fruits the Spirit bears in a Christian life.' },
	],
	penance: [
		{ href: '/moral-teaching#topic-5', title: 'Mortal and venial sin', excerpt: 'What makes a sin grave, and how each is forgiven.' },
		{ href: '/living-the-faith#topic-2', title: 'How to go to Confession', excerpt: 'A simple step-by-step guide.' },
		{ href: '/commandments', title: 'The Ten Commandments', excerpt: 'The usual starting point for an examination of conscience.' },
	],
	'holy-orders': [
		{ href: '/the-church#topic-3', title: 'Bishops, priests, deacons and the laity', excerpt: 'How the ordained ministry serves the whole Church.' },
		{ href: '/the-church#topic-4', title: 'Apostolic succession', excerpt: 'How the apostles’ mission is handed on through ordination.' },
	],
	matrimony: [
		{ href: '/living-the-faith#topic-5', title: 'Catholic dating, marriage and family life', excerpt: 'Discernment, preparation, and the domestic church.' },
		{ href: '/social-teaching#topic-6', title: 'Marriage, family and community', excerpt: 'The family as the first cell of society.' },
	],
	eucharist: [
		{ href: '/mass/order-of-mass', title: 'The Order of Mass', excerpt: 'Each part of the Mass, step by step.' },
		{ href: '/prayer-and-devotions#topic-3', title: 'Eucharistic adoration and Benediction', excerpt: 'Praying before Christ in the Blessed Sacrament.' },
		{ href: '/eucharistic-miracles', title: 'Eucharistic miracles', excerpt: 'Reported signs of the Real Presence, with their Church status.' },
		{ href: '/mass/items-used-at-mass', title: 'Items used at Mass', excerpt: 'The sacred vessels, altar linens, liturgical books, vestments, and colours used in celebrating the Eucharist.' },
	],
};
const extra = otherLinks[sacrament.slug] ?? [];
---

<ArticleLayout
	title={sacrament.title}
	description={sacrament.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="sacraments"
	label={groupOf(sacrament) ?? 'Sacrament'}
	lead={sacrament.excerpt}
	image={getCollectionImage('sacraments', sacrament.slug, getSacramentImageAlt(sacrament.title))}
	sections={sacrament.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(sacraments, index, 3, groupOf).map(toLink)}
	trust={sacrament}
>
	<SectionList sections={sacrament.sections} />
	{(guides.length > 0 || extra.length > 0) && (
		<section class="article-section">
			<h2>Go deeper</h2>
			<ul>
				{guides.map((guide) => (
					<li>
						<a href={withBase(`/sacraments/guides/${guide.slug}`)}>{guide.title}</a> — {guide.excerpt}
					</li>
				))}
				{extra.map((link) => (
					<li>
						<a href={withBase(link.href)}>{link.title}</a> — {link.excerpt}
					</li>
				))}
			</ul>
		</section>
	)}
</ArticleLayout>
