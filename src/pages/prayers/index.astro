---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { prayers, prayersIntro } from '../../data/prayers';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
---

<SectionLayout
	sectionKey="prayers"
	heading="Catholic Prayers"
	title="Prayers"
	description={PAGE_DESCRIPTIONS.prayers}
	currentPath={Astro.url.pathname}
	intro={prayersIntro}
	count={`${prayers.length} prayers`}
>
	{prayers.length === 0 ? (
		<EmptyState message="There are no prayers in this section yet." />
	) : (
		<ul class="prayer-list">
			{prayers.map((prayer) => (
				<li class="prayer-card">
					<h2 class="prayer-card__title">
						<a class="card__link" href={withBase(`/prayers/${prayer.slug}`)}>{prayer.title}</a>
					</h2>
					{prayer.alsoKnownAs && <p class="card__meta">Also called {prayer.alsoKnownAs}</p>}
					<blockquote class="prayer-text prayer-text--card">{prayer.text}</blockquote>
					<p class="card__excerpt">{prayer.excerpt}</p>
					<span class="card__action" aria-hidden="true">Read about this prayer <span class="card__arrow">→</span></span>
				</li>
			))}
		</ul>
	)}

	<p class="section-footer-links">
		These prayers are also said in the <a href={withBase('/rosary')}>Holy Rosary</a>, together with
		the Glory Be, the Apostles’ Creed, and other traditional prayers.
	</p>
</SectionLayout>
