---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { prayers, type Prayer } from '../../data/prayers';
import { withBase } from '../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return prayers.map((prayer) => ({ params: { slug: prayer.slug } }));
}

const index = prayers.findIndex((p) => p.slug === Astro.params.slug);
const prayer = prayers[index];

if (!prayer) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (p: Prayer): ArticleLink => ({
	href: withBase(`/prayers/${p.slug}`),
	title: p.title,
	label: 'Prayer',
	excerpt: p.excerpt,
});

const { prev, next } = getNeighbors(prayers, index);
const related: ArticleLink[] = [
	...getRelated(prayers, index).map(toLink),
	{
		href: withBase('/rosary'),
		title: 'Mysteries of the Rosary',
		label: 'Prayer',
		excerpt: 'How to pray the Rosary, its prayers, and the twenty mysteries for meditation.',
	},
];
---

<ArticleLayout
	title={prayer.title}
	description={prayer.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="prayers"
	label="Prayer"
	lead={prayer.excerpt}
	meta={prayer.alsoKnownAs ? [{ term: 'Also known as', value: prayer.alsoKnownAs }] : []}
	sections={prayer.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={related}
	trust={prayer}
>
	<blockquote class="prayer-text">{prayer.text}</blockquote>
	<SectionList sections={prayer.sections} />
</ArticleLayout>
