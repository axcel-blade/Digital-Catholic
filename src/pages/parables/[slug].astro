---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { parables, type Parable } from '../../data/parables';
import { withBase } from '../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return parables.map((parable) => ({ params: { slug: parable.slug } }));
}

const index = parables.findIndex((p) => p.slug === Astro.params.slug);
const parable = parables[index];

if (!parable) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (p: Parable): ArticleLink => ({
	href: withBase(`/parables/${p.slug}`),
	title: p.title,
	label: p.category,
	excerpt: p.excerpt,
});

const { prev, next } = getNeighbors(parables, index);
---

<ArticleLayout
	title={parable.title}
	description={parable.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="parables"
	label={`Parable · ${parable.category}`}
	lead={parable.excerpt}
	meta={[{ term: 'Gospel', value: parable.gospelReference }]}
	sections={parable.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(parables, index, 3, (p) => p.category).map(toLink)}
	trust={parable}
>
	<SectionList sections={parable.sections} />
</ArticleLayout>
