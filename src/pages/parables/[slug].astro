---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getParable, parables } from '../../data/parables';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
	return parables.map((parable) => ({
		params: { slug: parable.slug },
	}));
}

const slug = Astro.params.slug ?? '';
const parable = getParable(slug);

if (!parable) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const currentPath = Astro.url.pathname;
---

<ArticleLayout
	title={parable.title}
	description={parable.excerpt}
	currentPath={currentPath}
	backHref={withBase('/parables')}
	backLabel="All parables"
	category={`Parable · ${parable.category}`}
	asideLabel="Gospel illustration"
>
	<p class="article__lead article__lead--bordered">{parable.excerpt}</p>
	<p class="article__feast">Gospel: {parable.gospelReference}</p>
	{parable.sections.map((section) => (
		<section>
			<h2>{section.heading}</h2>
			{section.paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</section>
	))}
</ArticleLayout>
