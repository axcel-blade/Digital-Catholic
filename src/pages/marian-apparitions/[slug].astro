---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {
	getMarianApparition,
	marianApparitions,
	getMarianApparitionImageSrc,
} from '../../data/marianApparitions';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
	return marianApparitions.map((apparition) => ({
		params: { slug: apparition.slug },
	}));
}

const slug = Astro.params.slug ?? '';
const apparition = getMarianApparition(slug);

if (!apparition) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const currentPath = Astro.url.pathname;
---

<ArticleLayout
	title={apparition.title}
	description={apparition.excerpt}
	currentPath={currentPath}
	backHref={withBase('/marian-apparitions')}
	backLabel="All Marian apparitions"
	category={`Marian apparition · ${apparition.category}`}
	asideLabel="Marian devotion"
	imageSrc={getMarianApparitionImageSrc(apparition.slug)}
	imageAlt={apparition.imageAlt}
>
	<p class="article__lead article__lead--bordered">{apparition.excerpt}</p>
	<p class="article__feast">
		{apparition.location} · {apparition.date}
	</p>
	{apparition.sections.map((section) => (
		<section>
			<h2>{section.heading}</h2>
			{section.paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</section>
	))}
</ArticleLayout>
