---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import CardFilter from '../../components/CardFilter.astro';
import EmptyState from '../../components/EmptyState.astro';
import { miracles, miraclesIntro } from '../../data/miracles';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { slugify } from '../../lib/article';
import { getCollectionImage } from '../../lib/images';

const categories = [...new Set(miracles.map((m) => m.category))].map((category) => ({
	value: slugify(category),
	label: category,
	count: miracles.filter((m) => m.category === category).length,
}));
---

<SectionLayout
	sectionKey="miracles"
	heading="Miracles of Jesus Christ"
	title="Miracles of Jesus"
	description={PAGE_DESCRIPTIONS.miracles}
	currentPath={Astro.url.pathname}
	intro={miraclesIntro}
	count={`${miracles.length} Gospel accounts`}
>
	{miracles.length === 0 ? (
		<EmptyState />
	) : (
		<>
			<CardFilter
				target="miracle-list"
				label="Filter by kind of sign"
				options={categories}
				noun={{ one: 'miracle', many: 'miracles' }}
			/>
			<ul class="card-grid card-grid--media" id="miracle-list">
				{miracles.map((miracle, i) => (
					<EntryCard
						href={withBase(`/miracles/${miracle.slug}`)}
						title={miracle.title}
						label={miracle.category}
						meta={miracle.gospelReference}
						excerpt={miracle.excerpt}
						action="Read article"
						image={getCollectionImage('miracles', miracle.slug, miracle.imageAlt)}
						filterValue={slugify(miracle.category)}
						eager={i < 3}
					/>
				))}
			</ul>
		</>
	)}
	<p class="section-footer-links">
		See also <a href={withBase('/eucharistic-miracles')}>Eucharistic miracles</a> and the
		<a href={withBase('/parables')}>parables of Jesus</a>.
	</p>
</SectionLayout>
