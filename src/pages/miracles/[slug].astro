---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { miracles, type Miracle } from '../../data/miracles';
import { withBase } from '../../lib/paths';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return miracles.map((miracle) => ({ params: { slug: miracle.slug } }));
}

const index = miracles.findIndex((m) => m.slug === Astro.params.slug);
const miracle = miracles[index];

if (!miracle) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (m: Miracle): ArticleLink => ({
	href: withBase(`/miracles/${m.slug}`),
	title: m.title,
	label: m.category,
	excerpt: m.excerpt,
});

const { prev, next } = getNeighbors(miracles, index);
---

<ArticleLayout
	title={miracle.title}
	description={miracle.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="miracles"
	label={`Miracle · ${miracle.category}`}
	lead={miracle.excerpt}
	meta={[{ term: 'Gospel', value: miracle.gospelReference }]}
	sections={miracle.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(miracles, index, 3, (m) => m.category).map(toLink)}
	trust={miracle}
>
	<SectionList sections={miracle.sections} />
</ArticleLayout>
