---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getMiracle, miracles } from '../../data/miracles';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
	return miracles.map((miracle) => ({
		params: { slug: miracle.slug },
	}));
}

const slug = Astro.params.slug ?? '';
const miracle = getMiracle(slug);

if (!miracle) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const currentPath = Astro.url.pathname;
---

<ArticleLayout
	title={miracle.title}
	description={miracle.excerpt}
	currentPath={currentPath}
	backHref={withBase('/miracles')}
	backLabel="All miracles"
	category={`Miracle · ${miracle.category}`}
	asideLabel="Gospel illustration"
>
	<p class="article__lead article__lead--bordered">{miracle.excerpt}</p>
	<p class="article__feast">Gospel: {miracle.gospelReference}</p>
	{miracle.sections.map((section) => (
		<section>
			<h2>{section.heading}</h2>
			{section.paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</section>
	))}
</ArticleLayout>
