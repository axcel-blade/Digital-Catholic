---
import SectionLayout from '../../layouts/SectionLayout.astro';
import LegacyTopicRedirect from '../../components/LegacyTopicRedirect.astro';
import EntryCard from '../../components/EntryCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { saints, getSaintImageAlt, getSaintStatus } from '../../data/saints';
import { getGuide } from '../../data/guides';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';

const communion = getGuide('saints');
const biographies = `${saints.length} ${saints.length === 1 ? 'biography' : 'biographies'}`;
---

<SectionLayout
	sectionKey="learn"
	heading="Mary and the Saints"
	pageCrumb="Mary and the Saints"
	description={PAGE_DESCRIPTIONS.saints}
	currentPath={Astro.url.pathname}
	intro="Read the lives of the saints, and of holy men and women on the path to canonisation—their faith, trials, and love of God—so their example may guide your own journey in Christ."
	count={biographies}
>
	<LegacyTopicRedirect guideKey="saints" sectionId="communion-of-saints" />

	<p class="section-intro">
		New to how the Church recognises saints? Read <a href={withBase('/saints/path-to-sainthood')}>the path to sainthood</a>.
		For what the Church teaches about Mary, intercession, and relics, see
		<a href={withBase('/saints/topics')}>Mary and the Communion of Saints</a> ({communion.topics.length} topics).
	</p>

	{saints.length === 0 ? (
		<EmptyState />
	) : (
		<ul class="card-grid card-grid--media">
			{saints.map((saint, i) => (
				<EntryCard
					href={withBase(`/saints/${saint.slug}`)}
					title={saint.title}
					label={getSaintStatus(saint)}
					meta={saint.feastDays ? `Feast: ${saint.feastDays}` : saint.lifeDates}
					excerpt={saint.excerpt}
					action="Read biography"
					image={getCollectionImage('saints', saint.slug, getSaintImageAlt(saint.title))}
					eager={i < 3}
				/>
			))}
		</ul>
	)}

	<p class="section-footer-links">
		Continue with <a href={withBase('/marian-apparitions')}>Marian Apparitions</a> or the <a href={withBase('/rosary')}>Rosary</a>.
	</p>
</SectionLayout>
