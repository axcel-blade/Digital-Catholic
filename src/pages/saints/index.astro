---
import SectionLayout from '../../layouts/SectionLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { saints, getSaintImageAlt, getSaintStatus } from '../../data/saints';
import { PAGE_DESCRIPTIONS } from '../../lib/seo';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';

const currentPath = Astro.url.pathname;
---

<SectionLayout
	sectionKey="saints"
	heading="Saint Biographies"
	title="Saints"
	description={PAGE_DESCRIPTIONS.saints}
	currentPath={currentPath}
	intro="Read the lives of the saints, and of holy men and women on the path to canonization—their faith, trials, and love of God—so their example may guide your own journey in Christ."
	count={`${saints.length} ${saints.length === 1 ? 'biography' : 'biographies'}`}
>
	{saints.length === 0 ? (
		<EmptyState />
	) : (
		<ul class="card-grid card-grid--media">
			{saints.map((saint, i) => (
				<EntryCard
					href={withBase(`/saints/${saint.slug}`)}
					title={saint.title}
					label={getSaintStatus(saint)}
					meta={saint.feastDays ? `Feast: ${saint.feastDays}` : saint.lifeDates}
					excerpt={saint.excerpt}
					action="Read biography"
					image={getCollectionImage('saints', saint.slug, getSaintImageAlt(saint.title))}
					eager={i < 3}
				/>
			))}
		</ul>
	)}
</SectionLayout>
