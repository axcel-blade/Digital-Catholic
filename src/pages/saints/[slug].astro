---
import ArticleLayout, { type ArticleMeta } from '../../layouts/ArticleLayout.astro';
import SectionList from '../../components/SectionList.astro';
import { saints, getSaintImageAlt, getSaintStatus, type Saint } from '../../data/saints';
import { withBase } from '../../lib/paths';
import { getCollectionImage } from '../../lib/images';
import { getNeighbors, getRelated, type ArticleLink } from '../../lib/article';

export function getStaticPaths() {
	return saints.map((saint) => ({ params: { slug: saint.slug } }));
}

const index = saints.findIndex((s) => s.slug === Astro.params.slug);
const saint = saints[index];

if (!saint) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}

const toLink = (s: Saint): ArticleLink => ({
	href: withBase(`/saints/${s.slug}`),
	title: s.title,
	label: getSaintStatus(s),
	excerpt: s.excerpt,
});

const { prev, next } = getNeighbors(saints, index);
const meta: ArticleMeta[] = [
	...(saint.lifeDates ? [{ term: 'Life', value: saint.lifeDates }] : []),
	...(saint.feastDays ? [{ term: 'Feast days', value: saint.feastDays }] : []),
];
---

<ArticleLayout
	title={saint.title}
	description={saint.excerpt}
	currentPath={Astro.url.pathname}
	sectionKey="saints"
	label={getSaintStatus(saint)}
	lead={saint.excerpt}
	meta={meta}
	image={getCollectionImage('saints', saint.slug, getSaintImageAlt(saint.title))}
	sections={saint.sections}
	prev={prev && toLink(prev)}
	next={next && toLink(next)}
	related={getRelated(saints, index).map(toLink)}
	trust={saint}
>
	<SectionList sections={saint.sections} />
	<p class="callout callout--liturgy">
		What does “{getSaintStatus(saint)}” mean? Learn about <a href={withBase('/saints/path-to-sainthood')}>the path to sainthood</a>.
	</p>
</ArticleLayout>
